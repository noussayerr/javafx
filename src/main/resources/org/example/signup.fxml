<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.URL?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<StackPane fx:id="mainContainer" styleClass="main-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.SignupController">
    <stylesheets>
        <URL value="@styles/style.css" />
    </stylesheets>
    
    <VBox alignment="CENTER" spacing="20">
        <VBox maxWidth="450.0" styleClass="login-card">
            <!-- Header -->
            <VBox alignment="CENTER" spacing="5" styleClass="login-header">
                <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="header-title" text="Join Us! 🚀" />
                <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="header-subtitle" text="Create an account to start your journey" />
            </VBox>
            
            <!-- Body -->
            <VBox spacing="15" style="-fx-padding: 30;">
                <Label fx:id="errorLabel" managed="false" styleClass="alert-error" text="Registration failed" visible="false" wrapText="true" />
                
                <VBox spacing="5">
                    <Label style="-fx-text-fill: #6b7280;" text="Full Name" />
                    <TextField fx:id="nameField" promptText="Your name" styleClass="text-field" />
                </VBox>
                
                <VBox spacing="5">
                    <Label style="-fx-text-fill: #6b7280;" text="Email address" />
                    <TextField fx:id="emailField" promptText="name@example.com" styleClass="text-field" />
                </VBox>
                
                <VBox spacing="5">
                    <Label style="-fx-text-fill: #6b7280;" text="I am a..." />
                    <ChoiceBox fx:id="roleChoiceBox" maxWidth="Infinity" styleClass="text-field">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="athlete" />
                                <String fx:value="coach" />
                            </FXCollections>
                        </items>
                        <value>
                            <String fx:value="athlete" />
                        </value>
                    </ChoiceBox>
                </VBox>
                
                <VBox spacing="5">
                    <Label style="-fx-text-fill: #6b7280;" text="Password" />
                    <PasswordField fx:id="passwordField" promptText="Password" styleClass="text-field" />
                </VBox>
                
                <Button maxWidth="Infinity" onAction="#handleSignup" styleClass="btn-primary" text="Create Account" />
                
                <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 0 0;">
                    <HBox alignment="CENTER" spacing="5">
                        <Text text="Already have an account? " />
                        <Label onMouseClicked="#switchToLogin" styleClass="link-label" text="Sign In" />
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
