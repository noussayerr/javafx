<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.URL?>

<StackPane fx:id="mainContainer" styleClass="main-container" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.LoginController">
    <stylesheets>
        <URL value="@styles/style.css" />
    </stylesheets>
    
    <VBox alignment="CENTER" spacing="20">
        <VBox maxWidth="400.0" styleClass="login-card">
            <!-- Header -->
            <VBox alignment="CENTER" spacing="5" styleClass="login-header">
                <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="header-title" text="Welcome Back! 👋" />
                <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="header-subtitle" text="Sign in to continue your journey" />
            </VBox>
            
            <!-- Body -->
            <VBox spacing="20" style="-fx-padding: 30;">
                <Label fx:id="errorLabel" managed="false" styleClass="alert-error" text="Invalid credentials" visible="false" wrapText="true" />
                
                <VBox spacing="5">
                    <Label style="-fx-text-fill: #6b7280;" text="Email address" />
                    <TextField fx:id="emailField" promptText="name@example.com" styleClass="text-field" />
                </VBox>
                
                <VBox spacing="5">
                    <Label style="-fx-text-fill: #6b7280;" text="Password" />
                    <PasswordField fx:id="passwordField" promptText="Password" styleClass="text-field" />
                </VBox>
                
                <HBox alignment="CENTER_RIGHT">
                    <Label onMouseClicked="#handleForgotPassword" styleClass="link-label" text="Forgot password?" />
                </HBox>
                
                <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="btn-primary" text="Sign In" />
                
                <VBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 0 0;">
                    <HBox alignment="CENTER" spacing="5">
                        <Text text="Don't have an account? " />
                        <Label onMouseClicked="#switchToSignup" styleClass="link-label" text="Create one now" />
                    </HBox>
                </VBox>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
