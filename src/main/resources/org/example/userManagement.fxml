<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.URL?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.UserManagementController">
    <stylesheets>
        <URL value="@styles/style.css" />
    </stylesheets>
    
    <!-- Sidebar -->
    <VBox prefWidth="280.0" styleClass="sidebar" style="-fx-background-color: #1a2e35;">
        <VBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 30; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Text fill="#10b981" style="-fx-font-size: 24;" text="⚡" />
                <Text fill="WHITE" style="-fx-font-size: 20; -fx-font-weight: bold;" text="SportsPanel" />
            </HBox>
        </VBox>
        
        <VBox spacing="10" style="-fx-padding: 20;">
            <!-- Profile Summary -->
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 15; -fx-background-radius: 12;">
                <StackPane style="-fx-background-color: #10b981; -fx-background-radius: 12; -fx-padding: 10;">
                    <Text fill="WHITE" style="-fx-font-size: 20;" text="🛡️" />
                </StackPane>
                <VBox>
                    <Label fx:id="adminNameLabel" style="-fx-text-fill: white; -fx-font-weight: bold;" text="Admin Name" />
                    <Label style="-fx-text-fill: #10b981; -fx-font-size: 11;" text="ADMINISTRATOR" />
                </VBox>
            </HBox>
            
            <VBox spacing="5" style="-fx-padding: 20 0 0 0;">
                <HBox alignment="CENTER_LEFT" onMouseClicked="#handleBackToDashboard" spacing="15" styleClass="nav-item">
                    <Text text="📊" />
                    <Label styleClass="nav-text" text="Dashboard" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="nav-item, nav-item-active" style="-fx-background-color: #10b981;">
                    <Text fill="WHITE" text="👥" />
                    <Label styleClass="nav-text-active" text="Users" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="nav-item">
                    <Text text="🏆" />
                    <Label styleClass="nav-text" text="Competitions" />
                </HBox>
            </VBox>
        </VBox>
        
        <Region VBox.vgrow="ALWAYS" />
        
        <VBox style="-fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" onMouseClicked="#handleLogout" spacing="15" styleClass="nav-item">
                <Text fill="#ff6b6b" text="🚪" />
                <Label style="-fx-text-fill: #ff6b6b;" text="Logout" />
            </HBox>
        </VBox>
    </VBox>
    
    <!-- Main Content -->
    <VBox style="-fx-background-color: #f8f9fa;" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 30 40;">
            <VBox>
                <Text style="-fx-font-size: 28; -fx-font-weight: bold; -fx-fill: #1a2e35;" text="User Management" />
                <Text fill="#6b7280" text="View and manage all registered users" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#handleRefresh" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 10 20;" text="🔄 Refresh" />
        </HBox>
        
        <VBox spacing="20" style="-fx-padding: 0 40 40 40;" VBox.vgrow="ALWAYS">
            <TableView fx:id="userTable" style="-fx-background-radius: 12; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 0);" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                    <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Name" />
                    <TableColumn fx:id="emailColumn" prefWidth="200.0" text="Email" />
                    <TableColumn fx:id="roleColumn" prefWidth="100.0" text="Role" />
                    <TableColumn fx:id="verifiedColumn" prefWidth="100.0" text="Verified" />
                    <TableColumn fx:id="actionsColumn" prefWidth="200.0" text="Actions" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </VBox>
</HBox>
