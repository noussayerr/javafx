<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import java.net.URL?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.UserDashboardController">
    <stylesheets>
        <URL value="@styles/style.css" />
    </stylesheets>
    
    <!-- Sidebar -->
    <VBox prefWidth="280.0" styleClass="sidebar" style="-fx-background-color: #1a2e35;">
        <VBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 30; -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Text fill="#10b981" style="-fx-font-size: 24;" text="⚡" />
                <Text fill="WHITE" style="-fx-font-size: 20; -fx-font-weight: bold;" text="SportsPanel" />
            </HBox>
        </VBox>
        
        <VBox spacing="10" style="-fx-padding: 20;">
            <!-- Profile Summary -->
            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: rgba(255,255,255,0.05); -fx-padding: 15; -fx-background-radius: 12;">
                <StackPane style="-fx-background-color: #10b981; -fx-background-radius: 12; -fx-padding: 10;">
                    <Text fill="WHITE" style="-fx-font-size: 20;" text="🏃" />
                </StackPane>
                <VBox>
                    <Label fx:id="userNameLabel" style="-fx-text-fill: white; -fx-font-weight: bold;" text="User Name" />
                    <Label fx:id="roleLabel" style="-fx-text-fill: #10b981; -fx-font-size: 11;" text="ATHLETE" />
                </VBox>
            </HBox>
            
            <VBox spacing="5" style="-fx-padding: 20 0 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="nav-item, nav-item-active" style="-fx-background-color: #10b981;">
                    <Text fill="WHITE" text="📊" />
                    <Label styleClass="nav-text-active" text="Dashboard" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="nav-item">
                    <Text text="📉" />
                    <Label styleClass="nav-text" text="My Progress" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="nav-item">
                    <Text text="💪" />
                    <Label styleClass="nav-text" text="Workouts" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="nav-item">
                    <Text text="🥗" />
                    <Label styleClass="nav-text" text="Nutrition" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15" styleClass="nav-item">
                    <Text text="🎧" />
                    <Label styleClass="nav-text" text="Support" />
                </HBox>
            </VBox>
        </VBox>
        
        <Region VBox.vgrow="ALWAYS" />
        
        <VBox style="-fx-padding: 20;">
            <HBox alignment="CENTER_LEFT" onMouseClicked="#handleLogout" spacing="15" styleClass="nav-item">
                <Text fill="#ff6b6b" text="🚪" />
                <Label style="-fx-text-fill: #ff6b6b;" text="Logout" />
            </HBox>
        </VBox>
    </VBox>
    
    <!-- Main Content -->
    <VBox style="-fx-background-color: #f8f9fa;" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" style="-fx-padding: 30 40;">
            <VBox>
                <Text fx:id="welcomeText" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-fill: #1a2e35;" text="Welcome back, Athlete!" />
                <Text fill="#6b7280" text="Keep pushing towards your goals!" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER" spacing="10" style="-fx-background-color: white; -fx-padding: 10 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                <Text fill="#10b981" text="📅" />
                <Label fx:id="dateLabel" text="Thursday, April 09, 2026" />
            </HBox>
        </HBox>
        
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
            <VBox spacing="30" style="-fx-padding: 0 40 40 40;">
                <!-- Stats Row -->
                <HBox spacing="20">
                    <VBox prefWidth="230.0" spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #667eea, #764ba2); -fx-padding: 20; -fx-background-radius: 16;" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <VBox>
                                <Text fill="rgba(255,255,255,0.7)" style="-fx-font-size: 14;" text="Workouts Done" />
                                <Text fill="WHITE" style="-fx-font-size: 28; -fx-font-weight: bold;" text="24" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 50; -fx-padding: 10;">
                                <Text fill="WHITE" text="❤️" />
                            </StackPane>
                        </HBox>
                    </VBox>
                    
                    <VBox prefWidth="230.0" spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #f093fb, #f5576c); -fx-padding: 20; -fx-background-radius: 16;" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <VBox>
                                <Text fill="rgba(255,255,255,0.7)" style="-fx-font-size: 14;" text="Current Streak" />
                                <Text fill="WHITE" style="-fx-font-size: 28; -fx-font-weight: bold;" text="7 Days" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 50; -fx-padding: 10;">
                                <Text fill="WHITE" text="🔥" />
                            </StackPane>
                        </HBox>
                    </VBox>
                    
                    <VBox prefWidth="230.0" spacing="10" style="-fx-background-color: linear-gradient(to bottom right, #4ac29a, #bdfff3); -fx-padding: 20; -fx-background-radius: 16;" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT">
                            <VBox>
                                <Text fill="rgba(255,255,255,0.7)" style="-fx-font-size: 14;" text="Next Goal" />
                                <Text fill="WHITE" style="-fx-font-size: 20; -fx-font-weight: bold;" text="5kg Loss" />
                            </VBox>
                            <Region HBox.hgrow="ALWAYS" />
                            <StackPane style="-fx-background-color: rgba(255,255,255,0.2); -fx-background-radius: 50; -fx-padding: 10;">
                                <Text fill="WHITE" text="🎯" />
                            </StackPane>
                        </HBox>
                    </VBox>
                </HBox>
                
                <!-- Tools Row -->
                <HBox spacing="30">
                    <VBox prefWidth="450.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 0);" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 25;">
                            <StackPane style="-fx-background-color: rgba(16, 185, 129, 0.1); -fx-background-radius: 12; -fx-padding: 12;">
                                <Text fill="#10b981" style="-fx-font-size: 18;" text="🏃" />
                            </StackPane>
                            <VBox>
                                <Text style="-fx-font-size: 18; -fx-font-weight: bold; -fx-fill: #10b981;" text="Athlete Tools" />
                                <Text fill="#6b7280" style="-fx-font-size: 12;" text="Track your progress" />
                            </VBox>
                        </HBox>
                        <VBox spacing="10" style="-fx-padding: 0 25 25 25;">
                            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 10; -fx-cursor: hand;">
                                <StackPane style="-fx-background-color: rgba(16, 185, 129, 0.1); -fx-background-radius: 8; -fx-padding: 8;">
                                    <Text fill="#10b981" text="📈" />
                                </StackPane>
                                <VBox HBox.hgrow="ALWAYS">
                                    <Text style="-fx-font-weight: bold;" text="My Progress" />
                                    <Text fill="#6b7280" style="-fx-font-size: 11;" text="Track your fitness journey" />
                                </VBox>
                                <Text fill="#9ca3af" text="›" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 10; -fx-cursor: hand;">
                                <StackPane style="-fx-background-color: rgba(16, 185, 129, 0.1); -fx-background-radius: 8; -fx-padding: 8;">
                                    <Text fill="#10b981" text="💪" />
                                </StackPane>
                                <VBox HBox.hgrow="ALWAYS">
                                    <Text style="-fx-font-weight: bold;" text="Workouts" />
                                    <Text fill="#6b7280" style="-fx-font-size: 11;" text="View your workout plans" />
                                </VBox>
                                <Text fill="#9ca3af" text="›" />
                            </HBox>
                        </VBox>
                    </VBox>
                    
                    <VBox prefWidth="250.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 0);" HBox.hgrow="ALWAYS">
                         <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 25;">
                            <StackPane style="-fx-background-color: rgba(16, 185, 129, 0.1); -fx-background-radius: 12; -fx-padding: 12;">
                                <Text fill="#10b981" style="-fx-font-size: 18;" text="⚡" />
                            </StackPane>
                            <VBox>
                                <Text style="-fx-font-size: 18; -fx-font-weight: bold; -fx-fill: #10b981;" text="Quick Actions" />
                            </VBox>
                        </HBox>
                        <FlowPane hgap="15" style="-fx-padding: 0 25 25 25;" vgap="15">
                            <Button style="-fx-background-color: white; -fx-border-color: #10b981; -fx-border-radius: 8; -fx-text-fill: #10b981; -fx-padding: 12; -fx-pref-width: 180;">
                                <graphic>
                                    <VBox alignment="CENTER" spacing="5">
                                        <Text fill="#10b981" style="-fx-font-size: 18;" text="👤" />
                                        <Text text="Profile" />
                                    </VBox>
                                </graphic>
                            </Button>
                        </FlowPane>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
