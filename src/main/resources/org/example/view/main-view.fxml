<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="900.0" prefWidth="800.0"
            style="-fx-background-color: linear-gradient(to bottom right, #f0f4ff, #e3f2fd);"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.MainController">

    <children>

        <!-- ✅ Titre principal -->
        <Label layoutX="50.0" layoutY="40.0"
               style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"
               text="👋 Bienvenue Nounou 🎉" />

        <!-- ✅ Conteneur vertical des boutons -->
        <VBox layoutX="50.0" layoutY="100.0" spacing="12">
            <children>

                <!-- Bouton violet -->
                <Button text="🗂️ Voir les événements"
                        onAction="#afficherEvenements"
                        prefWidth="220" prefHeight="35"
                        style="-fx-background-color: linear-gradient(to right, #8e44ad, #9b59b6);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 15px;
                               -fx-background-radius: 30;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0.3, 0, 1);
                               -fx-cursor: hand;" />

                <!-- Bouton bleu ciel -->
                <Button text="📂 Gérer les catégories"
                        onAction="#ouvrirCategorieView"
                        prefWidth="220" prefHeight="35"
                        style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 15px;
                               -fx-background-radius: 30;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0.3, 0, 1);
                               -fx-cursor: hand;" />

                <!-- Bouton bleu profond -->
                <Button text="📊 Statistiques"
                        onAction="#ouvrirStatistiques"
                        prefWidth="220" prefHeight="35"
                        style="-fx-background-color: linear-gradient(to right, #2980b9, #3498db);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 15px;
                               -fx-background-radius: 30;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 3, 0.3, 0, 1);
                               -fx-cursor: hand;" />

                <!-- Bouton bleu ciel clair (spécial) -->
                <Button fx:id="btnEvenements"
                        text="🎟️ Voir les Événements"
                        onAction="#ouvrirListeEvenements"
                        prefWidth="220" prefHeight="35"
                        style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 15px;
                               -fx-background-radius: 30;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 3, 0.3, 0, 1);
                               -fx-cursor: hand;" />

            </children>
        </VBox>

    </children>
</AnchorPane>
