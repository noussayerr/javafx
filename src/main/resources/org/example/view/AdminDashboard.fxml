<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/16"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.AdminDashboardController"
            style="-fx-background-color: #f5f7fa;">

    <!-- Top Bar - Header -->
    <top>
        <HBox style="-fx-background-color: #34495e; -fx-padding: 15px;" alignment="CENTER_LEFT">
            <ImageView fitHeight="40" fitWidth="40">
                <Image url="@/images/admin-icon.png"/>
            </ImageView>
            <Label text="Tableau de bord Administrateur"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 0 10;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="logoutButton"
                        text="Déconnexion"
                        onAction="#handleLogout"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Circle radius="20" fill="#3498db" stroke="#ecf0f1" strokeWidth="1"/>
            </HBox>
        </HBox>
    </top>

    <!-- Left Side - Navigation Menu -->
    <left>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 20px 10px;"
              spacing="15" prefWidth="200">
            <Label text="NAVIGATION" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-padding: 0 0 10 5;"/>

            <Button text="Utilisateurs"
                    onAction="#goToUtilisateurs"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/users-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button text="Abonnements"
                    onAction="#handleAbonnementsNavigation"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/stats-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button text="Statistiques"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/stats-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button text="Paramètres"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/settings-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button text="Événements"
                    fx:id="btnEvenements"
                    onAction="#afficherEvenements"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/events-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button text="Jeux"
                    onAction="#afficherJeux"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/events-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button text="Matières"
                    onAction="#goToMatiere"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/matiere-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Aide"
                    style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 12px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="@/images/help-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- Center - Main Content Area -->
    <center>
        <StackPane>
            <!-- Dashboard Overview Cards -->
            <VBox spacing="20" style="-fx-padding: 20px;">
                <HBox spacing="20">
                    <!-- Users Card -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);"
                          prefWidth="250" prefHeight="150">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ImageView fitHeight="40" fitWidth="40">
                                <Image url="@/images/users-card-icon.png"/>
                            </ImageView>
                            <VBox>
                                <Label text="Utilisateurs" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                                <Label text="1,245" style="-fx-text-fill: #2c3e50; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>
                        <Separator style="-fx-padding: 10px 0;"/>
                        <Label text="+12% ce mois" style="-fx-text-fill: #27ae60; -fx-font-size: 12px;"/>
                    </VBox>

                    <!-- Active Sessions Card -->
                    <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);"
                          prefWidth="250" prefHeight="150">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <ImageView fitHeight="40" fitWidth="40">
                                <Image url="@/images/sessions-icon.png"/>
                            </ImageView>
                            <VBox>
                                <Label text="Sessions actives" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                                <Label text="87" style="-fx-text-fill: #2c3e50; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>
                        <Separator style="-fx-padding: 10px 0;"/>
                        <Label text="+5% aujourd'hui" style="-fx-text-fill: #27ae60; -fx-font-size: 12px;"/>
                    </VBox>
                </HBox>

                <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);">
                    <Label text="Liste des Utilisateurs" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 15 0;"/>
                    <TextField fx:id="searchField" promptText="Rechercher un utilisateur par nom, prénom ou email"
                               style="-fx-pref-width: 300px; -fx-padding: 10px;"/>
                    <Button fx:id="predictButton" text="Lancer la Prédiction de Churn"
                            onAction="#handlePredictChurn"
                            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10px;"/>
                    <TableView fx:id="usersTable" prefHeight="400">
                        <columns>
                            <TableColumn fx:id="nomColumn" text="Nom" prefWidth="100"/>
                            <TableColumn fx:id="prenomColumn" text="Prénom" prefWidth="100"/>
                            <TableColumn fx:id="emailColumn" text="Email" prefWidth="150"/>
                            <TableColumn fx:id="rolesColumn" text="Rôles" prefWidth="100"/>
                            <TableColumn fx:id="etatColumn" text="État" prefWidth="80"/>
                            <TableColumn fx:id="dateNaissanceColumn" text="Date de Naissance" prefWidth="120"/>
                            <TableColumn fx:id="niveauColumn" text="Niveau (Apprenant)" prefWidth="100"/>
                            <TableColumn fx:id="specialiteColumn" text="Spécialité (Enseignant)" prefWidth="120"/>
                            <TableColumn fx:id="experienceColumn" text="Expérience (Enseignant)" prefWidth="100"/>
                            <TableColumn fx:id="lastActivityColumn" text="Dernière Activité" prefWidth="150"/>
                            <TableColumn fx:id="actionColumn" text="Action" prefWidth="200"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </StackPane>
    </center>

    <!-- Bottom - Footer -->
    <bottom>
        <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 10px;" alignment="CENTER">
            <Label text="© 2023 Système de Gestion Admin - Tous droits réservés"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>