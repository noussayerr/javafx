<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controller.ResetPasswordController"
      alignment="CENTER" spacing="20" style="-fx-padding: 20;">
    <Label text="Réinitialiser le mot de passe" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label text="Entrez le code envoyé à votre email" style="-fx-font-size: 14px;"/>
    <TextField fx:id="codeField" promptText="Code de réinitialisation"/>
    <PasswordField fx:id="newPasswordField" promptText="Nouveau mot de passe"/>
    <PasswordField fx:id="confirmPasswordField" promptText="Confirmer le mot de passe"/>
    <Button text="Réinitialiser" onAction="#handleResetPassword"/>
    <Label fx:id="errorLabel" style="-fx-text-fill: #e74c3c;"/>
</VBox>