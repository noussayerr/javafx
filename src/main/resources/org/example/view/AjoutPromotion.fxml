<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="541.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1">
    <VBox alignment="CENTER" layoutX="20.0" layoutY="14.0" spacing="10.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="14.0">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Ajouter une Promotion" />
      <Label alignment="TOP_LEFT" text="titre de promotion" />

        <TextField fx:id="titreField" promptText="Titre de la promotion" />
      <Label alignment="TOP_LEFT" layoutX="276.0" layoutY="48.0" text="description de promotion" />
        <TextArea fx:id="descriptionField" prefRowCount="3" promptText="Description" />
      <Label alignment="TOP_LEFT" layoutX="276.0" layoutY="112.0" text="Taux de reduction" />
        <TextField fx:id="reductionField" promptText="Réduction (%)" />
      <Label alignment="TOP_LEFT" layoutX="276.0" layoutY="220.0" text="date de debut" />
        <DatePicker fx:id="dateDebutPicker" promptText="Date de début" />
      <Label alignment="TOP_LEFT" layoutX="276.0" layoutY="284.0" prefHeight="18.0" prefWidth="95.0" text="date de fin" />
        <DatePicker fx:id="dateFinPicker" promptText="Date de fin" />

        <Button onAction="#handleAjouterPromotion" text="Enregistrer" />
    </VBox>
</AnchorPane>
