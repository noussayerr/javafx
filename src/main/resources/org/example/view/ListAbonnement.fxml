<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/16"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.ListAbonnementController"
            style="-fx-background-color: #f5f7fa;">

    <!-- Top Bar - Header -->
    <top>
        <HBox style="-fx-background-color: #34495e; -fx-padding: 15px;" alignment="CENTER_LEFT">
            <ImageView fitHeight="40" fitWidth="40">
                <Image url="@/images/admin-icon.png"/>
            </ImageView>
            <Label text="Tableau de bord Administrateur"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 0 10;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="logoutButton"
                        text="Déconnexion"
                        onAction="#handleLogout"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Circle radius="20" fill="#3498db" stroke="#ecf0f1" strokeWidth="1"/>
            </HBox>
        </HBox>
    </top>

    <!-- Left Side - Navigation Menu -->
    <left>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 20px 10px;"
              spacing="15" prefWidth="200">
            <Label text="NAVIGATION" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-padding: 0 0 10 5;"/>

            <Button text="Utilisateurs"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/users-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Abonnements"
                    onAction="#handleAbonnementsNavigation"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/stats-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Paramètres"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/settings-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Aide"
                    style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 12px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="@/images/help-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- Center - Main Content Area -->
    <center>
        <VBox style="-fx-padding: 20px;" spacing="20">
            <!-- Header with title and add button -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 0 0 10 0;">
                <Label text="Gestion des Abonnements" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Ajouter Abonnement"
                        onAction="#goToAjoutAbonnement"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 15px;">

                </Button>
            </HBox>

            <!-- Table View -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);">
                <TableView fx:id="tableAbonnements" style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50.0" text="ID" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colTitre" prefWidth="150.0" text="Titre" />
                        <TableColumn fx:id="colPrix" prefWidth="100.0" text="Prix" style="-fx-alignment: CENTER_RIGHT;"/>
                        <TableColumn fx:id="colDescription" prefWidth="200.0" text="Description" />
                        <TableColumn fx:id="colDuration" prefWidth="100.0" text="Durée" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colPromotion" prefWidth="100.0" text="Promotion" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colActions" prefWidth="150.0" text="Actions" style="-fx-alignment: CENTER;"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </VBox>
        </VBox>
    </center>

    <!-- Bottom - Footer -->
    <bottom>
        <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 10px;" alignment="CENTER">
            <Label text="© 2023 Système de Gestion Admin - Tous droits réservés"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>
