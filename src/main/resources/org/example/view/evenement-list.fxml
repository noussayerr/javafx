<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.TextArea?>
<StackPane fx:id="mainContainer" prefHeight="800.0" prefWidth="1300.0" style="-fx-background-color: linear-gradient(to bottom, #f0f4ff, #e8eaf6)" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.EvenementListController">

    <children>
        <!-- 📦 Organisation verticale -->
        <VBox spacing="12" style="-fx-padding: 20;">

            <!-- 🔝 Zone des boutons -->
            <HBox alignment="TOP_RIGHT" spacing="10">
                <Button fx:id="btnFavoris" onAction="#ouvrirMesFavoris" style="-fx-background-color: #f7e1ff;                                -fx-text-fill: #8e44ad;                                -fx-font-size: 13px;                                -fx-font-weight: bold;                                -fx-background-radius: 20;                                -fx-padding: 6 15;" text="💖 Mes favoris" />

                <Button fx:id="btnScratch" onAction="#ouvrirScratchGame" style="-fx-background-color: #dcd6f7;                                -fx-text-fill: #5e60ce;                                -fx-font-size: 13px;                                -fx-font-weight: bold;                                -fx-background-radius: 20;                                -fx-padding: 6 15;" text="🎲 Jeu de cartes" />

                <Button text="voir calendrier"
                        onAction="#ouvrirCalendrier"
                        styleClass="modern-button"/>

                <Button fx:id="btnTraduire"
                        text="🌐 Traduction"
                        onAction="#ouvrirTraduction"
                        style="-fx-background-color: #f7e1ff;                                -fx-text-fill: #8e44ad;                                -fx-font-size: 13px;                                -fx-font-weight: bold;                                -fx-background-radius: 20;                                -fx-padding: 6 15;" />


                <!--   <Button fx:id="btnMap"
                        onAction="#ouvrirMap"
                        style="-fx-background-color: #f7e1ff;
               -fx-text-fill: #5e60ce;
               -fx-font-size: 13px;
               -fx-font-weight: bold;
               -fx-background-radius: 20;
               -fx-padding: 6 15;"
                        text="🗺️ Voir la carte" /> -->


            </HBox>


            <!-- 📜 Scroll avec cartes -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-background-color: transparent;                                -fx-padding: 10;">
                <content>
                    <FlowPane fx:id="eventContainer" hgap="25" style="-fx-padding: 20; -fx-alignment: center;" styleClass="themeable-flow-pane" vgap="25" />
                </content>
            </ScrollPane>
            <!-- 💬 Zone de commentaire -->
            <VBox fx:id="commentSection" spacing="10" style="-fx-padding: 20; -fx-background-color: white; -fx-background-radius: 15;">
                <!-- 🔁 Liste des commentaires -->
                <VBox fx:id="commentList" spacing="8" />

            </VBox>

        </VBox>
    </children>

    <!-- ✅ Feuilles de style -->
    <stylesheets>
        <String fx:value="/styles/scrollPane.css" />
        <String fx:value="/styles/animations.css" />
        <String fx:value="/styles/advanced.css" />
        <String fx:value="/styles/modern-events.css" />
    </stylesheets>

</StackPane>
