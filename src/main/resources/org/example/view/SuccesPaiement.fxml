<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.controller.PaiementSuccesController" prefWidth="400" prefHeight="300">
    <VBox alignment="CENTER" spacing="20" layoutX="50" layoutY="30" prefWidth="300" prefHeight="240">

        <!-- Icône de succès -->


        <!-- Message de succès -->
        <Label text="Paiement réussi !" style="-fx-font-size: 18px; -fx-text-fill: green; -fx-font-weight: bold;"/>

        <Label text="Merci pour votre achat." style="-fx-font-size: 14px; -fx-text-fill: #333;"/>

        <!-- Bouton de retour -->
        <Button text="Retour à l'accueil" onAction="#handleReturn" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px;" />

    </VBox>
</AnchorPane>
