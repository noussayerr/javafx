<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: linear-gradient(to bottom right, #f4f3fe, #eaeafc);-fx-border-color: #b0bec5; -fx-border-radius: 10; -fx-background-radius: 10;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.EvenementController">

    <top>
        <HBox alignment="TOP_RIGHT" spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Button fx:id="btnTheme" onAction="#toggleTheme" style="-fx-font-size: 16px; -fx-background-radius: 50%; -fx-cursor: hand;" text="🌙" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="10" styleClass="main-container">
            <padding>
                <Insets bottom="20" left="30" right="30" top="20" />
            </padding>

            <Label style="-fx-font-size: 26px;               -fx-font-weight: bold;               -fx-text-fill: #8e44ad;               -fx-effect: dropshadow(gaussian, #dcd6f7, 2, 0.3, 0, 1);               -fx-underline: true;" text="📋 Liste des événements" />




            <!-- Barre de recherche -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <TextField fx:id="searchField" prefWidth="300.0" promptText="🔍 Rechercher par titre..." style="-fx-background-color: #f9f9f9;                                   -fx-border-color: #ced4da;                                   -fx-border-radius: 8;                                   -fx-background-radius: 8;                                   -fx-padding: 8 12;                                   -fx-font-size: 14px;" />
                <Button onAction="#effacerRechercheEvenement" style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff);                -fx-text-fill: white;                -fx-font-weight: bold;                -fx-background-radius: 25;                -fx-padding: 8 16;                -fx-cursor: hand;" text="❌" />

            </HBox>

            <!-- Icône animée ⏳ -->
            <Label fx:id="loadingIcon" style="-fx-font-size: 20px; -fx-text-fill: #3498db;" text="⏳" visible="false" />
             <Button onAction="#ouvrirCategorieView" style="-fx-background-color: linear-gradient(to right, #a29bfe, #6c5ce7); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 15;" text="📁 Catégories" />

            <!-- Table des événements -->
            <TableView fx:id="tableEvenements" prefHeight="450" prefWidth="900" style="-fx-border-color: #dcdde1;">
                <columns>
                    <TableColumn fx:id="colCategorie" prefWidth="100" text="Catégorie ID" />
                    <TableColumn fx:id="colNom" prefWidth="150" text="Nom" />
                    <TableColumn fx:id="colDescription" prefWidth="200" text="Description" />
                    <TableColumn fx:id="colDate" prefWidth="100" text="Date" />
                    <TableColumn fx:id="colHeureDebut" prefWidth="100" text="Heure Début" />
                    <TableColumn fx:id="colHeureFin" prefWidth="100" text="Heure Fin" />
                    <TableColumn fx:id="colLieu" prefWidth="150" text="Lieu" />
                    <TableColumn fx:id="colImage" prefWidth="170" text="Image" />
                    <TableColumn fx:id="colActions" prefWidth="160" text="Actions" />
                </columns>
            </TableView>

            <!-- Boutons principaux -->
            <HBox alignment="CENTER" spacing="15">

                <Button onAction="#exporterPDF" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2);                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-background-radius: 20;" text="📄 Exporter PDF" />
                <Button onAction="#ouvrirStatistiques" prefHeight="14.0" prefWidth="131.0" style="-fx-background-color: linear-gradient(to right, #4facfe, #00f2fe);                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-font-size: 15px;                                -fx-background-radius: 30;                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 3, 0.3, 0, 1);                                -fx-cursor: hand;" text="📊 Statistiques" />

                <Button fx:id="btnEnvoyerMail" onAction="#envoyerPDFParMail" style="-fx-background-color: linear-gradient(to right, #3f2b96, #a8c0ff);                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-background-radius: 20;" text="📧 Envoyer par mail" />

                <Button onAction="#ouvrirFormulaireAjout" style="-fx-background-color: linear-gradient(to right, #74ebd5, #acb6e5);                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-background-radius: 25;" text="➕ Ajouter" />

                <Button onAction="#reinitialiserFiltresEtTri" style="-fx-background-color: linear-gradient(to right, #a29bfe, #6c5ce7);                                -fx-text-fill: white;                                -fx-font-weight: bold;                                -fx-background-radius: 25;" text="🔄 Réinitialiser" />

                <TextField fx:id="txtEmail" promptText="Adresse e-mail du client" style="-fx-background-color: #f9f9f9;                                   -fx-border-color: #ced4da;                                   -fx-border-radius: 8;                                   -fx-background-radius: 8;                                   -fx-padding: 6 10;                                   -fx-font-size: 14px;" />
            </HBox>

            <!-- Fonctions avancées -->
            <HBox alignment="CENTER" spacing="10" />

            <!-- Pagination -->
            <Pagination fx:id="pagination" layoutX="20" layoutY="600" />
        </VBox>
    </center>
</BorderPane>
