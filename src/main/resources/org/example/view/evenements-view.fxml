<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane style="-fx-background-color: linear-gradient(to bottom right, #f4f3fe, #eaeafc);-fx-border-color: #b0bec5; -fx-border-radius: 10; -fx-background-radius: 10;"
            xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/23.0.1"
            fx:controller="org.example.controller.EvenementController">

    <top>
        <HBox alignment="TOP_RIGHT" spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button fx:id="btnTheme" onAction="#toggleTheme" text="🌙"
                    style="-fx-font-size: 16px; -fx-background-radius: 50%; -fx-cursor: hand;" />
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="10" styleClass="main-container">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30" />
            </padding>

            <Label text="📋 Liste des événements"
                   style="-fx-font-size: 26px;
              -fx-font-weight: bold;
              -fx-text-fill: #8e44ad;
              -fx-effect: dropshadow(gaussian, #dcd6f7, 2, 0.3, 0, 1);
              -fx-underline: true;" />




            <!-- Barre de recherche -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <TextField fx:id="searchField"
                           prefWidth="300"
                           promptText="🔍 Rechercher par titre..."
                           style="-fx-background-color: #f9f9f9;
                                  -fx-border-color: #ced4da;
                                  -fx-border-radius: 8;
                                  -fx-background-radius: 8;
                                  -fx-padding: 8 12;
                                  -fx-font-size: 14px;" />
                <Button text="❌" onAction="#effacerRechercheEvenement"
                        style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff);
               -fx-text-fill: white;
               -fx-font-weight: bold;
               -fx-background-radius: 25;
               -fx-padding: 8 16;
               -fx-cursor: hand;" />

            </HBox>

            <!-- Icône animée ⏳ -->
            <Label fx:id="loadingIcon" text="⏳" visible="false"
                   style="-fx-font-size: 20px; -fx-text-fill: #3498db;" />

            <!-- Table des événements -->
            <TableView fx:id="tableEvenements" prefHeight="450" prefWidth="900" style="-fx-border-color: #dcdde1;">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                    <TableColumn fx:id="colCategorie" text="Catégorie ID" prefWidth="100" />
                    <TableColumn fx:id="colNom" text="Nom" prefWidth="150" />
                    <TableColumn fx:id="colDescription" text="Description" prefWidth="200" />
                    <TableColumn fx:id="colDate" text="Date" prefWidth="100" />
                    <TableColumn fx:id="colHeureDebut" text="Heure Début" prefWidth="100" />
                    <TableColumn fx:id="colHeureFin" text="Heure Fin" prefWidth="100" />
                    <TableColumn fx:id="colLieu" text="Lieu" prefWidth="150" />
                    <TableColumn fx:id="colPrix" text="Prix" prefWidth="80" />
                    <TableColumn fx:id="colImage" text="Image" prefWidth="170" />
                    <TableColumn fx:id="colPayer" text="Paiement" prefWidth="100"/>
                </columns>
            </TableView>

            <!-- Boutons principaux -->
            <HBox alignment="CENTER" spacing="15">
                <Button onAction="#modifierEvenement" text="📝 Modifier"
                        style="-fx-background-color: linear-gradient(to right, #74ebd5, #acb6e5);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 25;" />

                <Button onAction="#supprimerEvenement" text="🗑️ Supprimer"
                        style="-fx-background-color: linear-gradient(to right, #8e44ad, #9b59b6);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 25;" />

                <Button onAction="#ouvrirFormulaireAjout" text="➕ Ajouter"
                        style="-fx-background-color: linear-gradient(to right, #74ebd5, #acb6e5);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 25;" />

                <Button onAction="#reinitialiserFiltresEtTri" text="🔄 Réinitialiser"
                        style="-fx-background-color: linear-gradient(to right, #a29bfe, #6c5ce7);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 25;" />
            </HBox>

            <!-- Fonctions avancées -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="🕒 Tri Date ⬆️" onAction="#trierDateAscendant"
                        style="-fx-background-color: linear-gradient(to right, #74ebd5, #9face6);
                               -fx-text-fill: #2c3e50;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;" />

                <Button text="🕒 Tri Date ⬇️" onAction="#trierDateDescendant"
                        style="-fx-background-color: linear-gradient(to right, #89f7fe, #66a6ff);
                               -fx-text-fill: #2c3e50;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;" />

                <Button text="📄 Exporter PDF" onAction="#exporterPDF"
                        style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;" />

                <Button fx:id="btnEnvoyerMail" onAction="#envoyerPDFParMail" text="📧 Envoyer par mail"
                        style="-fx-background-color: linear-gradient(to right, #3f2b96, #a8c0ff);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 20;" />

                <TextField fx:id="txtEmail" promptText="Adresse e-mail du client"
                           style="-fx-background-color: #f9f9f9;
                                  -fx-border-color: #ced4da;
                                  -fx-border-radius: 8;
                                  -fx-background-radius: 8;
                                  -fx-padding: 6 10;
                                  -fx-font-size: 14px;" />
            </HBox>

            <!-- Pagination -->
            <Pagination fx:id="pagination" layoutX="20" layoutY="600" />
        </VBox>
    </center>
</BorderPane>
