<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/19"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.AjoutAbonnement"
            style="-fx-background-color: #f5f7fa;">

   <!-- Top Bar - Header -->
   <top>
      <HBox style="-fx-background-color: #34495e; -fx-padding: 15px;" alignment="CENTER_LEFT">
         <ImageView fitHeight="40" fitWidth="40">
            <Image url="@/images/admin-icon.png"/>
         </ImageView>
         <Label text="Ajouter un Abonnement"
                style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 0 10;"/>

         <Region HBox.hgrow="ALWAYS"/>

         <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="logoutButton"
                    text="Déconnexion"
                    onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
            <Circle radius="20" fill="#3498db" stroke="#ecf0f1" strokeWidth="1"/>
         </HBox>
      </HBox>
   </top>

   <!-- Left Side - Navigation Menu -->
   <left>
      <VBox style="-fx-background-color: #2c3e50; -fx-padding: 20px 10px;"
            spacing="15" prefWidth="200">
         <Label text="NAVIGATION" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-padding: 0 0 10 5;"/>

         <Button text="Utilisateurs"
                 onAction="#goToUtilisateurs"
                 style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
            <graphic>
               <ImageView fitHeight="20" fitWidth="20">
                  <Image url="@/images/users-icon.png"/>
               </ImageView>
            </graphic>
         </Button>

         <Button  text="Matières"
                  style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;"
                  onAction="#goToMatiere">
            <graphic>
               <ImageView fitHeight="20" fitWidth="20">
                  <Image url="@/images/matiere-icon.png"/>
               </ImageView>
            </graphic>
         </Button>

         <Button text="Abonnements"
                 onAction="#handleAbonnementsNavigation"
                 style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
            <graphic>
               <ImageView fitHeight="20" fitWidth="20">
                  <Image url="@/images/stats-icon.png"/>
               </ImageView>
            </graphic>
         </Button>

         <Button text="Événements"
                 fx:id="btnEvenements"
                 onAction="#afficherEvenements"
                 style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
            <graphic>
               <ImageView fitHeight="20" fitWidth="20">
                  <Image url="@/images/events-icon.png"/>
               </ImageView>
            </graphic>
         </Button>

         <Button text="Jeux"
                 onAction="#afficherJeux"
                 style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
            <graphic>
               <ImageView fitHeight="20" fitWidth="20">
                  <Image url="@/images/events-icon.png" />
               </ImageView>
            </graphic>
         </Button>


         <Button text="Statistiques"
                 style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
            <graphic>
               <ImageView fitHeight="20" fitWidth="20">
                  <Image url="@/images/stats-icon.png"/>
               </ImageView>
            </graphic>
         </Button>

         <Button text="Paramètres"
                 style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
            <graphic>
               <ImageView fitHeight="20" fitWidth="20">
                  <Image url="@/images/settings-icon.png"/>
               </ImageView>
            </graphic>
         </Button>

         <Region VBox.vgrow="ALWAYS"/>

         <Button text="Aide"
                 style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 12px; -fx-alignment: CENTER_LEFT;">
            <graphic>
               <ImageView fitHeight="16" fitWidth="16">
                  <Image url="@/images/help-icon.png"/>
               </ImageView>
            </graphic>
         </Button>
      </VBox>
   </left>

   <!-- Center - Add Subscription Form -->
   <center>
      <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30px;">
         <!-- Form Container -->
         <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 30px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" prefWidth="500">
            <Label text="Nouvel Abonnement" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 10 0;"/>

            <!-- Form Fields -->
            <GridPane hgap="20" vgap="15">
               <columnConstraints>
                  <ColumnConstraints prefWidth="150" halignment="RIGHT"/>
                  <ColumnConstraints prefWidth="250"/>
               </columnConstraints>

               <!-- Titre -->
               <Label text="Titre Abonnement:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-text-fill: #2c3e50;"/>
               <TextField fx:id="titreAbonnement" GridPane.rowIndex="0" GridPane.columnIndex="1" style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"/>

               <!-- Prix -->
               <Label text="Prix:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-text-fill: #2c3e50;"/>
               <TextField fx:id="prixAbonnement" GridPane.rowIndex="1" GridPane.columnIndex="1" style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"/>

               <!-- Description -->
               <Label text="Description:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-text-fill: #2c3e50;"/>
               <TextField fx:id="descriptionAbonnement" GridPane.rowIndex="2" GridPane.columnIndex="1" style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;"/>

               <!-- Période -->
               <Label text="Période:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-text-fill: #2c3e50;"/>
               <ComboBox fx:id="periode" GridPane.rowIndex="3" GridPane.columnIndex="1" style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" prefWidth="150.0"/>
            </GridPane>

            <!-- Submit Button -->
            <Button fx:id="AjoutButton" text="Ajouter" onAction="#AjouterPersonneAction"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5; -fx-padding: 8 20;"
                    GridPane.columnIndex="1" GridPane.halignment="RIGHT">

            </Button>
         </VBox>
      </VBox>
   </center>

   <!-- Bottom - Footer -->
   <bottom>
      <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 10px;" alignment="CENTER">
         <Label text="© 2023 Système de Gestion Admin - Tous droits réservés"
                style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
      </HBox>
   </bottom>
</BorderPane>