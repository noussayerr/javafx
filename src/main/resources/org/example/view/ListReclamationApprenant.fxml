<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.ListReclamationApprenant"
            prefHeight="400.0" prefWidth="600.0">

    <VBox prefWidth="220" style="-fx-background-color: linear-gradient(to bottom, #3498db, #2980b9);"
          AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0">

        <AnchorPane prefHeight="80" style="-fx-background-color: rgba(0,0,0,0.1);">
            <Label text="Mon Apprentissage"
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"
                   AnchorPane.leftAnchor="20" AnchorPane.topAnchor="25" />
        </AnchorPane>

        <VBox spacing="10" style="-fx-padding: 20 0 0 0;">
            <Button text="Tableau de bord"
                    onAction="#gotodash"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: baseline-left; -fx-padding: 10 20;">
                <graphic>
                    <ImageView fitWidth="20" fitHeight="20">
                        <Image url="@/icons/dashboard.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Mes Abonnements"
                    style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: baseline-left; -fx-padding: 10 20;" />

            <Button text="Progression"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: baseline-left; -fx-padding: 10 20;">
                <graphic>
                    <ImageView fitWidth="20" fitHeight="20">
                        <Image url="@/icons/progress.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Button fx:id="logoutbutton"
                text="Déconnexion"
                style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: baseline-left; -fx-padding: 10 20;">
            <graphic>
                <ImageView fitWidth="20" fitHeight="20">
                    <Image url="@/icons/logout.png"/>
                </ImageView>
            </graphic>
        </Button>
    </VBox>

    <!-- Main Content Area -->
    <VBox AnchorPane.leftAnchor="220" AnchorPane.topAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0"
          style="-fx-padding: 30;" spacing="20">

        <Label text="Mes Réclamations"
               style="-fx-font-size: 20px; -fx-font-weight: bold;" />

        <TableView fx:id="tableReclamations" prefHeight="500" prefWidth="700"
                   style="-fx-background-color: white; -fx-border-color: #2980b9; -fx-border-radius: 10; -fx-background-radius: 10;">
            <columns>
                <TableColumn fx:id="colTitre" text="Titre" prefWidth="200"
                             style="-fx-alignment: CENTER-LEFT;" />
                <TableColumn fx:id="colDescription" text="Description" prefWidth="350"
                             style="-fx-alignment: CENTER-LEFT;" />
                <TableColumn fx:id="colEtat" text="État" prefWidth="150"
                             style="-fx-alignment: CENTER;" />
            </columns>
        </TableView>

    </VBox>
</AnchorPane>
