<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.net.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="768.0" prefWidth="1366.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.Login">

    <!-- Left Side: Image -->
    <left>
        <StackPane prefWidth="683.0" style="-fx-background-color: #2c3e50;">
            <ImageView fitHeight="768.0" fitWidth="683.0" preserveRatio="true">
                <image>
                    <Image url="@/images/event1.jpg" />
                </image>
            </ImageView>
            <VBox alignment="CENTER" spacing="20" style="-fx-padding: 50;">
                <Label style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: white;" text="Connexion Sécurisée" />
                <Label style="-fx-font-size: 18px; -fx-text-fill: #ecf0f1; -fx-wrap-text: true; -fx-max-width: 500;" text="Accédez à votre espace personnel pour gérer vos cours et progresser" />
            </VBox>
        </StackPane>
    </left>

    <!-- Right Side: Form -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <content>
                <VBox alignment="CENTER" prefHeight="766.0" prefWidth="600.0" spacing="20" style="-fx-padding: 50; -fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 5); -fx-max-width: 600;">

                    <!-- Title -->
                    <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 20 0;" text="Connexion" />

                    <!-- Form Grid -->
                    <GridPane hgap="15" vgap="15">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="150.0" />
                            <ColumnConstraints prefWidth="300.0" />
                            <ColumnConstraints prefWidth="150.0" />
                        </columnConstraints>

                        <!-- Email -->
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #34495e; -fx-font-weight: bold;" text="Email :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                        <TextField fx:id="emailField" promptText="Entrez votre email" style="-fx-background-color: #ecf0f1; -fx-background-radius: 8; -fx-border-color: #bdc3c7; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                        <Label fx:id="emailError" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" GridPane.columnIndex="2" GridPane.rowIndex="0" />

                        <!-- Mot de passe -->
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #34495e; -fx-font-weight: bold;" text="Mot de passe :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                        <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe" style="-fx-background-color: #ecf0f1; -fx-background-radius: 8; -fx-border-color: #bdc3c7; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 14px;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                        <Label fx:id="passwordError" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                        <!-- CAPTCHA -->
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #34495e; -fx-font-weight: bold;" text="Vérification :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                        <HBox alignment="CENTER_LEFT" spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <ImageView fx:id="captchaQuestionImageView" fitHeight="40" fitWidth="150" preserveRatio="true" />
                            <TextField fx:id="captchaAnswerField" promptText="Réponse" style="-fx-background-color: #ecf0f1; -fx-background-radius: 8; -fx-border-color: #bdc3c7; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 14px; -fx-pref-width: 100;" />
                        </HBox>
                        <Label fx:id="captchaError" style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;" GridPane.columnIndex="2" GridPane.rowIndex="2" />

                        <!-- Remember Me -->
                        <CheckBox fx:id="rememberMeCheckBox" style="-fx-font-size: 14px; -fx-text-fill: #34495e;" text="Se souvenir de moi" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <rowConstraints>
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                     <RowConstraints />
                  </rowConstraints>
                    </GridPane>

                    <!-- Buttons Container -->
                    <VBox alignment="CENTER" spacing="20" style="-fx-padding: 30 0 0 0;">
                        <!-- HBox for FaceID and Se connecter -->
                        <HBox alignment="CENTER" spacing="20">
                            <Button fx:id="faceIdButton" disable="true" onAction="#handleFaceId" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: linear-gradient(to right, #2ecc71, #27ae60); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10; -fx-padding: 12 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="FaceID">
                                <styleClass>
                                    <String fx:value="faceid-button" />
                                </styleClass>
                            </Button>
                            <Button onAction="#handleLogin" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: linear-gradient(to right, #3498db, #2980b9); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10; -fx-padding: 12 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);" text="Se connecter">
                                <styleClass>
                                    <String fx:value="login-button" />
                                </styleClass>
                            </Button>
                            <Button onAction="#handleForgotPassword" style="-fx-background-color: transparent; -fx-text-fill: #e67e22; -fx-font-size: 14px; -fx-underline: true;" text="Mot de passe oublié ?" />
                        </HBox>
                        <!-- S'inscrire button below -->
                        <Button onAction="#redirectToChoice" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-font-weight: bold; -fx-font-size: 16px; -fx-border-color: #3498db; -fx-border-radius: 10; -fx-border-width: 2; -fx-padding: 12 40;" text="S'inscrire">
                            <styleClass>
                                <String fx:value="signup-button" />
                            </styleClass>
                        </Button>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

    <!-- CSS for hover effects and animations -->
    <stylesheets>
        <URL value="@/styles/login.css" />
    </stylesheets>
</BorderPane>
