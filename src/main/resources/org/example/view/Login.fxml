<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<?import java.lang.String?>
<?import java.net.URL?>
<AnchorPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.Login"
            prefHeight="400.0" prefWidth="300.0"
            style="-fx-background-color: linear-gradient(to bottom right, #e9ecef, #f4f4f4);">

    <VBox alignment="CENTER" spacing="25.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0"
          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">

        <!-- Title -->
        <Label text="Connexion"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 20 0;"/>

        <!-- Form Grid -->
        <GridPane hgap="10" vgap="15">
            <columnConstraints>
                <ColumnConstraints prefWidth="100.0"/>
                <ColumnConstraints prefWidth="150.0"/>
            </columnConstraints>

            <!-- Email -->
            <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                   style="-fx-font-size: 14px; -fx-text-fill: #34495e;"/>
            <TextField fx:id="emailField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-background-color: #ecf0f1; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 8; -fx-font-size: 14px;"
                       promptText="Entrez votre email"/>

            <!-- Mot de passe -->
            <Label text="Mot de passe:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                   style="-fx-font-size: 14px; -fx-text-fill: #34495e;"/>
            <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                           style="-fx-background-color: #ecf0f1; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 8; -fx-font-size: 14px;"
                           promptText="Entrez votre mot de passe"/>
        </GridPane>

        <!-- Login Button -->
        <Button text="Se connecter" onAction="#handleLogin"
                style="-fx-background-color: linear-gradient(to right, #3498db, #2980b9); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 8; -fx-padding: 10 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"
                prefWidth="150.0" prefHeight="40.0">
            <styleClass>
                <String fx:value="login-button"/>
            </styleClass>
        </Button>

        <!-- Sign Up Button -->
        <Button text="S'inscrire" onAction="#redirectToChoice"
                style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-font-weight: bold; -fx-font-size: 14px; -fx-border-color: #3498db; -fx-border-radius: 8; -fx-border-width: 2; -fx-padding: 8 20;"
                prefWidth="150.0" prefHeight="40.0">
            <styleClass>
                <String fx:value="signup-button"/>
            </styleClass>
        </Button>

        <!-- Error Label -->
        <Label fx:id="errorLabel"
               style="-fx-text-fill: #e74c3c; -fx-font-size: 12px; -fx-padding: 5 0 0 0;"/>
    </VBox>

    <!-- Optional: Add subtle CSS for hover effect -->
    <stylesheets>
        <URL value="@/styles/login.css"/>
    </stylesheets>
</AnchorPane>