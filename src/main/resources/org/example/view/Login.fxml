<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<?import java.lang.String?>
<?import java.net.URL?>
<AnchorPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.Login"
            prefHeight="600.0" prefWidth="500.0"
            style="-fx-background-color: linear-gradient(to bottom right, #e9ecef, #f4f4f4);">

    <VBox alignment="CENTER" spacing="35.0" AnchorPane.bottomAnchor="40.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="40.0"
          style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 15, 0, 0, 8);">

        <!-- Title - Enhanced -->
        <Label text="Connexion"
               style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #2c3e50; -fx-padding: 0 0 30 0;"/>

        <!-- Form Grid - Enlarged -->
        <GridPane hgap="15" vgap="20">
            <columnConstraints>
                <ColumnConstraints prefWidth="120.0"/>
                <ColumnConstraints prefWidth="200.0"/>
            </columnConstraints>

            <!-- Email - Bigger -->
            <Label text="Email:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                   style="-fx-font-size: 16px; -fx-text-fill: #34495e;"/>
            <TextField fx:id="emailField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-background-color: #ecf0f1; -fx-background-radius: 8; -fx-border-color: #bdc3c7; -fx-border-radius: 8; -fx-padding: 12; -fx-font-size: 16px;"
                       promptText="Entrez votre email"/>

            <!-- Mot de passe - Bigger -->
            <Label text="Mot de passe:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                   style="-fx-font-size: 16px; -fx-text-fill: #34495e;"/>
            <PasswordField fx:id="passwordField" GridPane.rowIndex="1" GridPane.columnIndex="1"
                           style="-fx-background-color: #ecf0f1; -fx-background-radius: 8; -fx-border-color: #bdc3c7; -fx-border-radius: 8; -fx-padding: 12; -fx-font-size: 16px;"
                           promptText="Entrez votre mot de passe"/>
        </GridPane>

        <!-- Buttons Container for better alignment -->
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20 0 0 0;">
            <!-- Login Button - Enhanced -->
            <Button text="Se connecter" onAction="#handleLogin"
                    style="-fx-background-color: linear-gradient(to right, #3498db, #2980b9); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 10; -fx-padding: 15 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 8, 0, 0, 3);"
                    prefWidth="200.0" prefHeight="50.0">
                <styleClass>
                    <String fx:value="login-button"/>
                </styleClass>
            </Button>

            <!-- Sign Up Button - Enhanced -->
            <Button text="S'inscrire" onAction="#redirectToChoice"
                    style="-fx-background-color: transparent; -fx-text-fill: #3498db; -fx-font-weight: bold; -fx-font-size: 16px; -fx-border-color: #3498db; -fx-border-radius: 10; -fx-border-width: 2; -fx-padding: 12 30;"
                    prefWidth="200.0" prefHeight="50.0">
                <styleClass>
                    <String fx:value="signup-button"/>
                </styleClass>
            </Button>
        </VBox>

        <!-- Error Label - Bigger -->
        <Label fx:id="errorLabel"
               style="-fx-text-fill: #e74c3c; -fx-font-size: 14px; -fx-padding: 10 0 0 0;"/>
    </VBox>

    <!-- Optional: Add subtle CSS for hover effect -->
    <stylesheets>
        <URL value="@/styles/login.css"/>
    </stylesheets>
</AnchorPane>