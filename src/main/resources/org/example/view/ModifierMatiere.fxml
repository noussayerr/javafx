<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.ModifierMatiereController"
            style="-fx-background-color: #f5f7fa;">

    <top>
        <HBox style="-fx-background-color: #34495e; -fx-padding: 15px;" alignment="CENTER_LEFT">
            <ImageView fitHeight="40" fitWidth="40">
                <Image url="@/images/admin-icon.png"/>
            </ImageView>
            <Label text="Tableau de bord Administrateur"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 0 10;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="logoutButton"
                        text="Déconnexion"
                        onAction="#handleLogout"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Circle radius="20" fill="#3498db" stroke="#ecf0f1" strokeWidth="1"/>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 20px 10px;" spacing="15" prefWidth="200">
            <Label text="NAVIGATION" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-padding: 0 0 10 5;"/>
            <Button text="Utilisateurs" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/users-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Matières" onAction="#goToMatiere"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/matiere-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Statistiques" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/stats-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button text="Paramètres" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/settings-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Abonnements"
                    onAction="#handleAbonnementsNavigation"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/stats-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Événements"
                    fx:id="btnEvenements"
                    onAction="#afficherEvenements"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/events-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button text="Jeux"
                    onAction="#afficherJeux"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/events-icon.png" />
                    </ImageView>
                </graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Aide" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 12px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="@/images/help-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <StackPane>
            <VBox spacing="20" alignment="CENTER"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5);">

                <Label text="Modifier une Matière"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <GridPane hgap="15" vgap="5">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="120.0"/>
                        <ColumnConstraints prefWidth="300.0"/>
                    </columnConstraints>

                    <!-- Nom -->
                    <Label text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="nomMField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label fx:id="nomErrorLabel" text="" style="-fx-text-fill: red;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <!-- Titre -->
                    <Label text="Titre:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="titreMField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                    <Label fx:id="titreErrorLabel" text="" style="-fx-text-fill: red;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <!-- Description -->
                    <Label text="Description:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextArea fx:id="descMField" prefRowCount="3" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    <Label fx:id="descErrorLabel" text="" style="-fx-text-fill: red;" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <!-- Objectifs -->
                    <Label text="Objectifs:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <TextArea fx:id="objMField" prefRowCount="2" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
                    <Label fx:id="objErrorLabel" text="" style="-fx-text-fill: red;" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

                    <!-- Image -->
                    <Label text="Image:" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                    <HBox spacing="10" GridPane.rowIndex="8" GridPane.columnIndex="1">
                        <TextField fx:id="imgMField" editable="false"/>
                        <Button text="Parcourir" onAction="#handleUploadImage"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    </HBox>
                </GridPane>

                <!-- Boutons -->
                <HBox alignment="CENTER" spacing="20">
                    <Button text="Modifier" onAction="#handleModifierMatiere"
                            style="-fx-background-color: linear-gradient(to right, #3498db, #2980b9); -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 25;"/>
                    <Button text="Annuler" onAction="#handleAnnuler"
                            style="-fx-background-color: transparent; -fx-border-color: #bdc3c7; -fx-text-fill: #7f8c8d; -fx-padding: 10 25;"/>
                </HBox>

                <!-- Message général -->
                <Label fx:id="errorLabel" style="-fx-text-fill: red;"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
