<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.collections.FXCollections?>
<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.ModifierCoursController"
            prefHeight="400.0" prefWidth="600.0">
    <VBox spacing="10" layoutX="50" layoutY="20" alignment="TOP_LEFT">

        <Label text="Modifier un Cours" style="-fx-font-size: 22px; -fx-font-weight: bold;" />

        <!-- Nom -->
        <HBox spacing="10">
            <Label text="Nom du cours :" minWidth="130"/>
            <TextField fx:id="nomField" promptText="Entrez le nom du cours"/>
        </HBox>
        <Label fx:id="nomErrorLabel" textFill="red"/>

        <!-- Objectif -->
        <HBox spacing="10">
            <Label text="Objectif :" minWidth="130"/>
            <TextField fx:id="objField" promptText="Entrez l’objectif du cours"/>
        </HBox>
        <Label fx:id="objErrorLabel" textFill="red"/>

        <!-- Date -->
        <HBox spacing="10">
            <Label text="Date :" minWidth="130"/>
            <DatePicker fx:id="datePicker"/>
        </HBox>
        <Label fx:id="dateErrorLabel" textFill="red"/>

        <!-- Niveau -->
        <HBox spacing="10">
            <Label text="Niveau :" minWidth="130"/>
            <ComboBox fx:id="niveauCombo" promptText="Choisir le niveau">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Débutant"/>
                        <String fx:value="Intermédiaire"/>
                        <String fx:value="Avancé"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </HBox>
        <Label fx:id="niveauErrorLabel" textFill="red"/>

        <!-- Type -->
        <HBox spacing="10">
            <Label text="Type :" minWidth="130"/>
            <ComboBox fx:id="typeCombo" promptText="Choisir le type">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="free"/>
                        <String fx:value="premium"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </HBox>
        <Label fx:id="typeErrorLabel" textFill="red"/>

        <!-- Boutons -->
        <HBox alignment="CENTER" spacing="20">
            <Button text="Modifier" onAction="#modifierCours"
                    style="-fx-background-color: #2196F3; -fx-text-fill: white;" maxWidth="200"/>
            <Button text="Annuler" onAction="#handleAnnuler"
                    style="-fx-background-color: transparent; -fx-border-color: #bdc3c7; -fx-text-fill: #7f8c8d; -fx-padding: 10 25;"/>
        </HBox>
    </VBox>

</AnchorPane>
