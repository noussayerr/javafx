<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.ListTransactionController">

    <VBox prefWidth="220" style="-fx-background-color: linear-gradient(to bottom, #3498db, #2980b9);">
        <AnchorPane prefHeight="80" style="-fx-background-color: rgba(0,0,0,0.1);">
            <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Mon Apprentissage" AnchorPane.leftAnchor="20" />
        </AnchorPane>

        <VBox spacing="10" style="-fx-padding: 20 0 0 0;">
            <Button onAction="#gotodash" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: baseline-left; -fx-padding: 10 20;" text="Tableau de bord">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/icons/dashboard.png" />
                    </ImageView>
                </graphic>
            </Button>

            <Button style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: baseline-left; -fx-padding: 10 20;" text="Mes Abonnements">
                onAction="#handleAbonnementsNavigation"
            </Button>

            <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: baseline-left; -fx-padding: 10 20;" text="Progression">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/icons/progress.png" />
                    </ImageView>
                </graphic>
            </Button>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />

        <Button fx:id="logoutbutton" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: baseline-left; -fx-padding: 10 20;" text="Déconnexion">
            <graphic>
                <ImageView fitHeight="20" fitWidth="20">
                    <Image url="@/icons/logout.png" />
                </ImageView>
            </graphic>
        </Button>
    </VBox>

    <VBox AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="220" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="My Transactions" />

        <TableView fx:id="transactionTable" prefHeight="400" prefWidth="600">
            <columns>
                <TableColumn fx:id="amountCol" text="Amount" />
                <TableColumn fx:id="transactionIdCol" text="Transaction ID" />
                <TableColumn fx:id="transactionDateCol" text="Date" />
                <TableColumn fx:id="statusCol" text="Status" />
                <TableColumn fx:id="pdfCol" prefWidth="80" text="PDF" />
            </columns>
        </TableView>
    </VBox>
</AnchorPane>
