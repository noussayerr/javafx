<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.image.Image?>
<HBox fx:id="matiereCard" spacing="15" alignment="CENTER" styleClass="matiere-card"
      xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.controller.MatiereCardController">
    <VBox alignment="CENTER" spacing="15" style="-fx-background-color: #FFFFFF; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 4);"
          prefWidth="220" prefHeight="260">
        <ImageView fx:id="imageView" fitHeight="120" fitWidth="180" preserveRatio="true" />
        <Label fx:id="nomLabel" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-text-fill: #4B5EAA; -fx-alignment: center;" wrapText="true" />
        <Label fx:id="titreLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-text-fill: #6B7280; -fx-alignment: center;" wrapText="true" />
        <HBox alignment="CENTER" spacing="5">
            <ImageView fitHeight="16.0" fitWidth="16.0">
                <image>
                    <Image url="@/images" />
                </image>
            </ImageView>
        </HBox>
    </VBox>
</HBox>