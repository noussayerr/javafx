<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.StatistiquesController"
            prefWidth="900.0" prefHeight="800.0"
            stylesheets="@/styles/stats.css">

    <VBox spacing="25" alignment="TOP_CENTER"
          AnchorPane.topAnchor="40.0"
          AnchorPane.leftAnchor="40.0"
          AnchorPane.rightAnchor="40.0">

        <!-- 🔹 En-tête -->
        <HBox alignment="CENTER" spacing="15">
            <Label text="📊" styleClass="header-icon"/>
            <Label text="Statistiques Avancées" styleClass="header-title"/>
        </HBox>

        <!-- 🔸 Cartes statistiques -->
        <HBox spacing="30" alignment="CENTER">
            <VBox styleClass="stat-card" spacing="5" alignment="CENTER">
                <Label text="Catégories" styleClass="stat-label"/>
                <Label fx:id="lblTotalCategories" styleClass="stat-value"/>
                <Label text="au total" styleClass="stat-subtext"/>
            </VBox>

            <VBox styleClass="stat-card" spacing="5" alignment="CENTER">
                <Label text="Top Catégorie" styleClass="stat-label"/>
                <Label fx:id="lblCategoriePlusUtilisee" styleClass="stat-value highlight"/>
                <Label text="la plus utilisée" styleClass="stat-subtext"/>
            </VBox>
        </HBox>

        <!-- 📊 BarChart : Activité Mensuelle -->
        <VBox spacing="20" styleClass="chart-container">
            <Label text="Activité Mensuelle" styleClass="chart-title"/>
            <BarChart fx:id="barChart" prefHeight="300" prefWidth="900" legendVisible="false">
                <xAxis>
                    <CategoryAxis fx:id="xAxis" label="Mois" tickLabelRotation="45"/>
                </xAxis>
                <yAxis>
                    <NumberAxis label="Événements"/>
                </yAxis>
            </BarChart>
        </VBox>

        <!-- 🥧 PieChart + Légende -->
        <HBox spacing="40" alignment="CENTER">
            <VBox styleClass="chart-container" spacing="20">
                <Label text="Répartition par Catégorie" styleClass="chart-title"/>
                <PieChart fx:id="pieChart" prefWidth="400" prefHeight="300"/>
            </VBox>

            <VBox styleClass="legend-container" spacing="10">
                <Label text="Légende" styleClass="legend-title"/>
                <FlowPane fx:id="legendPane" hgap="15" vgap="10" alignment="TOP_LEFT"/>
            </VBox>
        </HBox>

        <!-- ⏳ Indicateur de chargement -->
        <Label fx:id="loadingIcon" text="⏳"
               styleClass="loading-indicator"
               visible="false"/>
    </VBox>
</AnchorPane>
