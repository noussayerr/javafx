<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.StatistiquesController"
            prefWidth="1200.0" prefHeight="900.0"
            stylesheets="@/styles/stats.css">

    <ScrollPane fitToWidth="true" fitToHeight="true"
                AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                style="-fx-background-color: transparent;">
        <content>
            <VBox spacing="30" alignment="TOP_CENTER" style="-fx-padding: 40;">

                <!-- En-tête -->
                <HBox alignment="CENTER" spacing="15">
                    <Label text="📊" styleClass="header-icon"/>
                    <Label text="Statistiques Avancées" styleClass="header-title"/>
                </HBox>

                <!-- Cartes statistiques -->
                <HBox spacing="50" alignment="CENTER">
                    <VBox styleClass="stat-card" spacing="5" alignment="CENTER">
                        <Label text="Catégories" styleClass="stat-label"/>
                        <Label fx:id="lblTotalCategories" styleClass="stat-value"/>
                        <Label text="au total" styleClass="stat-subtext"/>
                    </VBox>

                    <VBox styleClass="stat-card" spacing="5" alignment="CENTER">
                        <Label text="Top Catégorie" styleClass="stat-label"/>
                        <Label fx:id="lblCategoriePlusUtilisee" styleClass="stat-value highlight"/>
                        <Label text="la plus utilisée" styleClass="stat-subtext"/>
                    </VBox>
                </HBox>

                <!-- BarChart -->
                <VBox spacing="20" styleClass="chart-container" alignment="CENTER">
                    <Label text="Activité Mensuelle" styleClass="chart-title"/>
                    <BarChart fx:id="barChart" prefHeight="350" prefWidth="1000" legendVisible="false">
                        <xAxis>
                            <CategoryAxis fx:id="xAxis" label="Mois" tickLabelRotation="0" tickLabelGap="20">
                                <tickLabelFont>
                                    <Font name="Arial" size="15"/>
                                </tickLabelFont>
                            </CategoryAxis>
                        </xAxis>
                        <yAxis>
                            <NumberAxis label="Événements"/>
                        </yAxis>
                    </BarChart>
                </VBox>

                <!-- PieChart + Légende -->
                <HBox spacing="60" alignment="CENTER">
                    <VBox styleClass="chart-container" spacing="20" alignment="CENTER">
                        <Label text="Répartition par Catégorie" styleClass="chart-title"/>
                        <PieChart fx:id="pieChart" prefWidth="400" prefHeight="300"/>
                    </VBox>

                    <VBox styleClass="legend-container" spacing="10" alignment="TOP_LEFT">
                        <Label text="Légende" styleClass="legend-title"/>
                        <FlowPane fx:id="legendPane" hgap="15" vgap="10"/>
                    </VBox>
                </HBox>

                <!-- Chargement -->
                <Label fx:id="loadingIcon" text="⏳"
                       styleClass="loading-indicator"
                       visible="false"/>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>
