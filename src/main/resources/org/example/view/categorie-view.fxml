<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Pagination?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.CategorieController">

    <BorderPane style="-fx-background-color: linear-gradient(to bottom right, #f4f3fe, #eaeafc); -fx-border-radius: 10; -fx-background-radius: 10;">

        <center>
            <VBox alignment="CENTER" prefHeight="692.0" prefWidth="817.0" spacing="15">
                <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

                <!-- Titre -->
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #8e44ad; -fx-underline: true;" text="📁 Liste des catégories" />

                <!-- Barre de recherche stylée -->
                <HBox alignment="CENTER_RIGHT" spacing="10">
                    <TextField fx:id="txtRecherche" prefWidth="300" promptText="🔍 Rechercher une catégorie..." style="-fx-background-color: #f9f9f9;                                       -fx-border-color: #ced4da;                                       -fx-border-radius: 8;                                       -fx-background-radius: 8;                                       -fx-padding: 8 12;                                       -fx-font-size: 14px;" />

                    <Button onAction="#effacerRecherche" style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff);                                    -fx-text-fill: white;                                    -fx-font-weight: bold;                                    -fx-background-radius: 25;                                    -fx-padding: 8 16;                                    -fx-cursor: hand;" text="❌" />
                </HBox>

                <!-- Chargement -->
                <Label fx:id="loadingIcon" style="-fx-font-size: 18px; -fx-text-fill: #3498db;" text="⏳" visible="false" />

                <!-- Table -->
                <TableView fx:id="tableCategories" prefHeight="400" prefWidth="720">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="50" text="ID" />
                        <TableColumn fx:id="colNom" prefWidth="150" text="Nom" />
                        <TableColumn fx:id="colDescription" prefWidth="300" text="Description" />
                        <TableColumn fx:id="colImage" prefWidth="150" text="Image" />
                    </columns>
                </TableView>

                <!-- 🔘 Boutons d'action -->
                <HBox alignment="CENTER" spacing="12">
                    <Button onAction="#ouvrirFormulaireAjout" style="-fx-background-color: linear-gradient(to right, #74ebd5, #acb6e5);                            -fx-text-fill: #2c3e50;                            -fx-font-weight: bold;                            -fx-background-radius: 25;                            -fx-padding: 8 20;                            -fx-cursor: hand;" text="➕ Ajouter" />

                    <Button onAction="#modifierCategorie" style="-fx-background-color: linear-gradient(to right, #8e44ad, #9b59b6);                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 25;                            -fx-padding: 8 20;                            -fx-cursor: hand;" text="📝 Modifier" />

                    <Button onAction="#supprimerCategorie" style="-fx-background-color: linear-gradient(to right, #74ebd5, #acb6e5);                           -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 25;                            -fx-padding: 8 20;                            -fx-cursor: hand;" text="🗑️ Supprimer" />

                    <Button onAction="#trierParNom" style="-fx-background-color: linear-gradient(to right, #a29bfe, #6c5ce7);                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 25;                            -fx-padding: 8 20;                            -fx-cursor: hand;" text="🔄 Réinitialiser (A → Z)" />

                    <Button onAction="#trierParNomDesc" style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2);                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 25;                            -fx-padding: 8 20;                            -fx-cursor: hand;" text="⬇️ Trier Z → A" />
                </HBox>

                <Pagination fx:id="pagination" layoutX="20" layoutY="600" />

            </VBox>
        </center>
    </BorderPane>
</AnchorPane>
