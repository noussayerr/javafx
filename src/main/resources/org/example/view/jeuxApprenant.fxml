<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom right, #f5f7fa, #c3cfe2);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.JeuxController">

    <!-- Same header as dashboard -->
    <HBox style="-fx-background-color: rgba(255,255,255,0.3); -fx-background-radius: 15;" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
        <effect>
            <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.1)" height="10" radius="10" width="10" />
        </effect>

        <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@/images/admin-icon.png" />
            </image>
        </ImageView>

        <Label style="-fx-text-fill: #3a4a6d; -fx-font-size: 24px; -fx-font-weight: bold;" text="DysCover" HBox.hgrow="ALWAYS" />

        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 0 15 0 0;">
            <Button style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Accueil" onAction="#showHome" />
            <Button style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Cours" onAction="#showCourses" />
            <Button style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="les Événements" onAction="#ouvrirListeEvenements" />
            <Button style="-fx-background-color: #4a6baf; -fx-text-fill: white; -fx-font-weight: bold;" text="Jeux"  />
            <Button style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Profil" onAction="#handleProfile" />
            <Button onAction="#handleLogout" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Déconnexion">
                <HBox.margin>
                    <Insets left="200.0" />
                </HBox.margin>
            </Button>
        </HBox>
    </HBox>

    <!-- Games content -->
    <VBox alignment="TOP_CENTER" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="100.0">
        <!-- Title -->
        <Label style="-fx-font-size: 24px; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Jeux Éducatifs" />

        <!-- Games Table -->
        <HBox spacing="10" alignment="CENTER_LEFT">

            <Button fx:id="launchButton" text="Lancer le jeu" onAction="#launchGame" disable="true"
                    style="-fx-background-color: #9b59b6; -fx-text-fill: white;"/>
        </HBox>

        <TableView fx:id="jeuxTable" style="-fx-background-color: white; -fx-background-radius: 15;" prefHeight="400.0">
            <effect>
                <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.1)" height="10" radius="10" width="10" />
            </effect>

            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="nomColumn" text="Nom du Jeu" prefWidth="200" />
                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="300" />
                <TableColumn fx:id="typeColumn" text="Catégorie" prefWidth="150" />
                <TableColumn fx:id="docColumn" text="Date de Création" prefWidth="120"/>

            </columns>
        </TableView>
    </VBox>

    <!-- Same footer as dashboard -->
    <HBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.5); -fx-background-radius: 10; -fx-padding: 10;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
        <Label style="-fx-text-fill: #3a4a6d;" text="© 2023 Learning Platform - Tous droits réservés" />
    </HBox>
</AnchorPane>
