<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.control.DatePicker?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.ProfileEnseignant"
            prefHeight="600.0" prefWidth="1000.0"
            style="-fx-background-color: linear-gradient(to bottom right, #f8f9fa, #e9ecef);">

    <!-- Menu supérieur -->
    <HBox style="-fx-background-color: rgba(255,255,255,0.3); -fx-background-radius: 15;"
          AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
        <effect>
            <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.1)" height="10" radius="10" width="10" />
        </effect>

        <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="/images/admin-icon.png" />
            </image>
        </ImageView>

        <Label style="-fx-text-fill: #495057; -fx-font-size: 24px; -fx-font-weight: bold; -fx-font-family: 'Comic Sans MS';"
               text="DysCover" HBox.hgrow="ALWAYS" />

        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 0 15 0 0;">
            <Button fx:id="dashboardButton" onAction="#loadDashboard" style="-fx-background-color: transparent; -fx-text-fill: #495057; -fx-font-weight: bold; -fx-font-family: 'Arial Rounded MT Bold';"
                    text="Tableau de bord" />
            <Button onAction="#goMatiereF" style="-fx-background-color: transparent; -fx-text-fill: #495057; -fx-font-weight: bold; -fx-font-family: 'Arial Rounded MT Bold';"
                    text="Mes Cours" />
            <Button fx:id="profileButton" onAction="#handleProfile" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-family: 'Arial Rounded MT Bold';"
                    text="Profil" />
            <Button fx:id="logoutButton" onAction="#logout" style="-fx-background-color: transparent; -fx-text-fill: #495057; -fx-font-weight: bold; -fx-font-family: 'Arial Rounded MT Bold';"
                    text="Déconnexion">
                <HBox.margin>
                    <Insets left="300.0" />
                </HBox.margin>
            </Button>
        </HBox>
    </HBox>

    <!-- Contenu central - Formulaire Enseignant -->
    <VBox alignment="TOP_CENTER" spacing="10.0"
          AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="100.0">

        <!-- Carte de profil -->
        <StackPane prefHeight="400.0" prefWidth="900.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;">
            <effect>
                <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.1)" height="10" radius="10" width="10" />
            </effect>

            <GridPane hgap="15" vgap="8">
                <columnConstraints>
                    <ColumnConstraints prefWidth="200" />
                    <ColumnConstraints prefWidth="300" />
                </columnConstraints>

                <!-- Photo de profil -->
                <StackPane GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.rowSpan="10">
                    <VBox spacing="8">
                        <ImageView fx:id="profileImageView" fitHeight="150" fitWidth="150" preserveRatio="true" />
                        <TextField fx:id="photoProfilField" disable="true" promptText="Photo de profil"
                                   style="-fx-background-color: #ecf0f1; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 6; -fx-font-size: 13px;"
                                   prefHeight="25.0" />
                        <Button fx:id="uploadPhotoButton" text="Choisir une photo" onAction="#handlePhotoUpload"
                                style="-fx-font-family: 'Arial Rounded MT Bold';" />
                    </VBox>
                </StackPane>

                <!-- Informations du profil -->
                <Label style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                       text="Nom:" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <TextField fx:id="nomField" GridPane.columnIndex="1" GridPane.rowIndex="1"
                           style="-fx-background-color: #ecf0f1; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 6; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                           prefHeight="25.0" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                       text="Prénom:" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <TextField fx:id="prenomField" GridPane.columnIndex="1" GridPane.rowIndex="3"
                           style="-fx-background-color: #ecf0f1; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 6; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                           prefHeight="25.0" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                       text="Email:" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                <TextField fx:id="emailField" GridPane.columnIndex="1" GridPane.rowIndex="5"
                           style="-fx-background-color: #ecf0f1; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 6; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                           prefHeight="25.0" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                       text="Date de naissance:" GridPane.columnIndex="1" GridPane.rowIndex="6" />
                <TextField fx:id="dateNaissanceField" GridPane.columnIndex="1" GridPane.rowIndex="7"
                           style="-fx-background-color: #ecf0f1; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 6; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                           prefHeight="25.0" promptText="YYYY-MM-DD" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                       text="Téléphone:" GridPane.columnIndex="1" GridPane.rowIndex="8" />
                <TextField fx:id="telephoneField" GridPane.columnIndex="1" GridPane.rowIndex="9"
                           style="-fx-background-color: #ecf0f1; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 6; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                           prefHeight="25.0" />

                <!-- Spécificités Enseignant -->
                <Label style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                       text="Spécialité:" GridPane.columnIndex="1" GridPane.rowIndex="10" />
                <ComboBox fx:id="specialiteComboBox" GridPane.columnIndex="1" GridPane.rowIndex="11"
                          style="-fx-background-color: #ecf0f1; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 6; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                          prefHeight="25.0" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                       text="Années d'expérience:" GridPane.columnIndex="1" GridPane.rowIndex="12" />
                <TextField fx:id="experienceField" GridPane.columnIndex="1" GridPane.rowIndex="13"
                           style="-fx-background-color: #ecf0f1; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 6; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                           prefHeight="25.0" />

                <Label style="-fx-font-weight: bold; -fx-text-fill: #495057; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                       text="Mot de passe:" GridPane.columnIndex="1" GridPane.rowIndex="14" />
                <PasswordField fx:id="passwordField" GridPane.columnIndex="1" GridPane.rowIndex="15"
                               style="-fx-background-color: #ecf0f1; -fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 6; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                               prefHeight="25.0" />

                <HBox spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="16" style="-fx-padding: 5 0 0 0;">
                    <Button fx:id="saveButton" style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-background-radius: 5; -fx-pref-width: 120; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                            text="Enregistrer" onAction="#handleSave" />
                    <Button style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 5; -fx-pref-width: 120; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';"
                            text="Annuler" />
                </HBox>
            </GridPane>
        </StackPane>
    </VBox>

    <!-- Footer -->
    <HBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.5); -fx-background-radius: 10; -fx-padding: 10;"
          AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
        <Label style="-fx-text-fill: #495057; -fx-font-size: 13px; -fx-font-family: 'Arial Rounded MT Bold';" text="© 2023 DysCover - Plateforme d'éducation pour la dyslexie" />
    </HBox>
</AnchorPane>