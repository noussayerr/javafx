<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="801.0" prefWidth="1366.0" style="-fx-background-color: #F4F7FC;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.MatiereFrontAController">
    <!-- Header avec effet de verre -->
    <HBox style="-fx-background-color: rgba(255,255,255,0.3); -fx-background-radius: 15;" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
        <effect>
            <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.1)" height="10" radius="10" width="10" />
        </effect>

        <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@/images/admin-icon.png" />
            </image>
        </ImageView>

        <Label style="-fx-text-fill: #3a4a6d; -fx-font-size: 24px; -fx-font-weight: bold;" text="DysCover" HBox.hgrow="ALWAYS" />

        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 0 15 0 0;">
            <Button style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Accueil" />
            <Button onAction="#goMatiereF" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Cours" />
            <Button fx:id="profileButton" onAction="#ouvrirListeEvenements" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="les Événements" />
            <Button fx:id="btnEvenements" onAction="#handleProfile" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Profil" />
            <Button onAction="#showGames" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Jeux" />
            <Button fx:id="logoutButton" onAction="#logout" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Déconnexion">
                <HBox.margin>
                    <Insets left="300.0" />
                </HBox.margin></Button>
        </HBox>
    </HBox>
    <VBox alignment="TOP_CENTER" layoutX="-4.0" layoutY="78.0" prefHeight="118.0" prefWidth="1007.0" style="-fx-background-color: #4B5EAA;" AnchorPane.leftAnchor="-4.0" AnchorPane.rightAnchor="-3.0" AnchorPane.topAnchor="78.0">
        <padding>
            <Insets left="40.0" top="30.0" />
        </padding>
        <Label alignment="CENTER" style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-text-fill: #FFFFFF;" text="Notre Matières" />
        <Label alignment="CENTER" style="-fx-font-size: 14px; -fx-font-family: 'Segoe UI'; -fx-text-fill: rgba(255,255,255,0.7); -fx-padding: 5 0 0 0;" text="Accueil • Notre matières" />
    </VBox>
    <!-- Main Content Area -->
    <HBox prefHeight="600.0" prefWidth="1000.0" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="200.0">
        <!-- Left Section: Cards and Pagination -->
        <VBox prefHeight="632.0" prefWidth="663.0" HBox.hgrow="ALWAYS">
            <!-- Filter and Display Info -->
            <HBox alignment="CENTER_LEFT" prefHeight="46.0" prefWidth="1031.0" style="-fx-padding: 20 20 10 20;">
                <Label fx:id="displayInfoLabel" prefHeight="15.0" prefWidth="155.0" style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-text-fill: #4B5EAA;" text="Affichage de 1 à 8 sur 0">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <HBox alignment="TOP_RIGHT" blendMode="SRC_ATOP" prefHeight="34.0" prefWidth="496.0">
                    <children>
                        <TextField fx:id="searchField" alignment="TOP_LEFT" prefHeight="25.0" prefWidth="240.0" promptText=" 🔍 Rechercher..." style="-fx-background-color: #FFFFFF; -fx-border-color: #D1D5DB; -fx-border-radius: 5; -fx-background-radius: 5; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;" />
                        <Button alignment="CENTER" onAction="#effacerRecherche" prefHeight="31.0" prefWidth="46.0" style="-fx-background-color: linear-gradient(to right, #00c6ff, #0072ff); -fx-text-fill: white; -fx-font-weight: bold;-fx-background-radius: 25; -fx-padding: 8 16; -fx-cursor: hand;" text="❌">
                        </Button>
                    </children>
                </HBox>
            </HBox>
            <!-- Scrollable Content Area for Cards -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" prefHeight="464.0" prefWidth="1031.0" style="-fx-background-color: transparent; -fx-padding: 0 20 20 20;">
                <TilePane fx:id="matiereContainer" alignment="CENTER" hgap="20.0" prefTileHeight="280" prefTileWidth="240" style="-fx-background-color: transparent;" vgap="20.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </TilePane>
            </ScrollPane>
            <!-- Pagination Controls -->
            <HBox alignment="CENTER" prefHeight="22.0" prefWidth="1031.0" style="-fx-padding: 10 20;">
                <Button fx:id="prevButton" onAction="#previousPage" style="-fx-background-color: #E8EDFF; -fx-text-fill: #4B5EAA; -fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-background-radius: 5; -fx-padding: 5 10;" text="◀" />
                <HBox fx:id="pageButtons" alignment="CENTER" spacing="5.0" HBox.hgrow="ALWAYS" />
                <Button fx:id="nextButton" onAction="#nextPage" style="-fx-background-color: #E8EDFF; -fx-text-fill: #4B5EAA; -fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-background-radius: 5; -fx-padding: 5 10;" text="▶" />
            </HBox>
        </VBox>
        <!-- Right Sidebar -->
        <VBox prefHeight="542.0" prefWidth="285.0" spacing="10" style="-fx-padding: 20; -fx-background-color: transparent;">
            <!-- Categories -->
            <VBox spacing="5" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-text-fill: #1734a4;" text="Nos Matières" />
                <VBox fx:id="categoriesContainer" alignment="CENTER" spacing="5.0" />
            </VBox>
            <!-- Price Filter -->
            <VBox spacing="5" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-text-fill: #1734a4;" text="Filtre de prix" />
                <VBox spacing="5.0">
                    <Label fx:id="totalCountLabel" style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-text-fill: #0e0e0e;" text="Tous (0)" />
                    <Label fx:id="freeCountLabel" style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-text-fill: #0e0e0e;" text="Cours gratuits (0)" />
                    <Label fx:id="premiumCountLabel" style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-text-fill: #0e0e0e;" text="Cours Premium (0)" />
                </VBox>
            </VBox>
            <!-- Skill Level Filter -->
            <VBox spacing="5" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-font-family: 'Segoe UI'; -fx-text-fill: #1734a4;" text="Niveau de compétence" />
                <VBox spacing="5.0">
                    <Label fx:id="totalLevelCountLabel" style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-text-fill: #0e0e0e;" text="Tous les niveaux (0)" />
                    <Label fx:id="beginnerCountLabel" style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-text-fill: #0e0e0e;" text="Débutant (0)" />
                    <Label fx:id="intermediateCountLabel" style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-text-fill: #0e0e0e;" text="Intermédiaire (0)" />
                    <Label fx:id="expertCountLabel" style="-fx-font-size: 12px; -fx-font-family: 'Segoe UI'; -fx-text-fill: #0e0e0e;" text="Expert (0)" />
                </VBox>
            </VBox>
        </VBox>
    </HBox>
    <!-- Footer -->
    <HBox alignment="CENTER" style="-fx-background-color: rgba(255,255,255,0.5); -fx-background-radius: 10; -fx-padding: 10;" AnchorPane.bottomAnchor="10.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0">
        <Label style="-fx-text-fill: #495057; -fx-font-family: 'Arial Rounded MT Bold';" text="© 2023 DysCover - Plateforme d'éducation pour la dyslexie" />
    </HBox>
</AnchorPane>
