<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.AjouterCategorieController"
            prefWidth="500" prefHeight="600"
            style="-fx-background-color: linear-gradient(to bottom right, #f4f3fe, #eaeafc);">

    <!-- 🌙 Thème -->
    <Button fx:id="btnTheme"
            layoutX="450" layoutY="15" text="🌙"
            onAction="#toggleTheme"
            style="-fx-background-color: #a29bfe;
                   -fx-text-fill: white;
                   -fx-background-radius: 50%;
                   -fx-cursor: hand;" />

    <VBox layoutX="30" layoutY="30" spacing="20" prefWidth="440">
        <!-- ✅ Titre -->
        <Label text="➕ Ajouter une catégorie"
               style="-fx-font-size: 24px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #8e44ad;
                      -fx-underline: true;" />

        <!-- ✅ Formulaire -->
        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="100"/>
                <ColumnConstraints minWidth="250"/>
            </columnConstraints>

            <!-- Nom -->
            <Label text="Nom :" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNom" promptText="Nom de la catégorie" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label fx:id="lblErreurNom" text="" textFill="red" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <!-- Description -->
            <Label text="Description :" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextArea fx:id="txtDescription" promptText="Description"
                      prefRowCount="3"
                      GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label fx:id="lblErreurDescription" text="" textFill="red" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <!-- Image -->
            <Label text="Image :" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <VBox spacing="5" GridPane.rowIndex="4" GridPane.columnIndex="1">
                <HBox spacing="5">
                    <TextField fx:id="txtImage" editable="false" promptText="Aucune image sélectionnée" HBox.hgrow="ALWAYS"/>
                    <Button text="📁" onAction="#choisirImage"
                            style="-fx-background-color: linear-gradient(to right, #8e44ad, #9b59b6);
                                   -fx-text-fill: white;
                                   -fx-background-radius: 25;
                                   -fx-cursor: hand;" />
                </HBox>
                <Label fx:id="lblNomImage" text=""
                       style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;" />
                <ImageView fx:id="imagePreview" fitHeight="120" fitWidth="120" preserveRatio="true"
                           style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0.3, 0, 2);" />
            </VBox>
        </GridPane>

        <!-- ✅ Boutons d'action -->
        <HBox alignment="CENTER" spacing="20">
            <Button text="💾 Ajouter" onAction="#ajouterCategorie"
                    style="-fx-background-color: linear-gradient(to right, #74ebd5, #acb6e5);
                           -fx-text-fill: #2c3e50;
                           -fx-font-weight: bold;
                           -fx-background-radius: 25;
                           -fx-padding: 8 20;
                           -fx-cursor: hand;" />

            <Button text="❌ Annuler" onAction="#fermerFenetre"
                    style="-fx-background-color: linear-gradient(to right, #a29bfe, #6c5ce7);
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 25;
                           -fx-padding: 8 20;
                           -fx-cursor: hand;" />
        </HBox>
    </VBox>
</AnchorPane>
