<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.AjouterEvenementController"
            style="-fx-background-color: linear-gradient(to bottom right, #f4f3fe, #eaeafc);"
            prefWidth="1000.0" prefHeight="700.0">

    <!-- Top Bar -->
    <top>
        <HBox style="-fx-background-color: #34495e; -fx-padding: 15px;" alignment="CENTER_LEFT">
            <ImageView fitHeight="40" fitWidth="40">
                <Image url="@/images/admin-icon.png"/>
            </ImageView>
            <Label text="Tableau de bord Administrateur"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 0 10;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="logoutButton"
                        text="Déconnexion"
                        onAction="#handleLogout"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Circle radius="20" fill="#3498db" stroke="#ecf0f1" strokeWidth="1"/>
            </HBox>
        </HBox>
    </top>

    <left>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 20px 10px;"
              spacing="15" prefWidth="200">
            <Label text="NAVIGATION" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-padding: 0 0 10 5;"/>

            <Button text="Utilisateurs"
                    onAction="#goToUtilisateurs"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/users-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button  text="Matières"
                     style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;"
                     onAction="#goToMatiere">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/matiere-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Abonnements"
                    onAction="#handleAbonnementsNavigation"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/stats-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Événements"
                    fx:id="btnEvenements"
                    onAction="#afficherEvenements"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/events-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Jeux"
                    onAction="#afficherJeux"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/events-icon.png" />
                    </ImageView>
                </graphic>
            </Button>


            <Button text="Statistiques"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/stats-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Paramètres"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/settings-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Aide"
                    style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 12px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="@/images/help-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- Formulaire au centre -->
    <center>
        <VBox layoutX="30" layoutY="30" spacing="10" prefWidth="700">
            <Label text="➕ Ajouter un événement"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #5e4b8b;" />

            <GridPane hgap="10" vgap="5">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" />
                    <ColumnConstraints minWidth="220" />
                </columnConstraints>

                <!-- Titre -->
                <Label text="Nom" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <TextField fx:id="txtTitre" promptText="Nom de l’événement" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                <Label fx:id="lblErreurTitre" textFill="red" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <!-- Description -->
                <Label text="Description" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <TextArea fx:id="txtDescription" prefRowCount="2" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                <Label fx:id="lblErreurDescription" textFill="red" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                <!-- Lieu -->
                <Label text="Lieu" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <TextField fx:id="txtLieu" promptText="Ex: Tunis, Salle 4" GridPane.rowIndex="4" GridPane.columnIndex="1" />
                <Label fx:id="lblErreurLieu" textFill="red" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                <!-- Date -->
                <Label text="Date" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                <DatePicker fx:id="datePicker" GridPane.rowIndex="6" GridPane.columnIndex="1" />
                <Label fx:id="lblErreurDate" textFill="red" GridPane.rowIndex="7" GridPane.columnIndex="1" />

                <!-- Heure Début -->
                <Label text="Heure Début" GridPane.rowIndex="8" GridPane.columnIndex="0" />
                <Spinner fx:id="spinnerHeureDebut" prefWidth="180" GridPane.rowIndex="8" GridPane.columnIndex="1" />
                <Label fx:id="lblErreurHeureDebut" textFill="red" GridPane.rowIndex="9" GridPane.columnIndex="1" />

                <!-- Heure Fin -->
                <Label text="Heure Fin" GridPane.rowIndex="10" GridPane.columnIndex="0" />
                <Spinner fx:id="spinnerHeureFin" prefWidth="180" GridPane.rowIndex="10" GridPane.columnIndex="1" />
                <Label fx:id="lblErreurHeureFin" textFill="red" GridPane.rowIndex="11" GridPane.columnIndex="1" />

                <!-- Catégorie -->
                <Label text="Catégorie" GridPane.rowIndex="12" GridPane.columnIndex="0" />
                <ComboBox fx:id="comboCategorie" promptText="Choisissez une catégorie"
                          prefWidth="180" GridPane.rowIndex="12" GridPane.columnIndex="1" />
                <Label fx:id="lblErreurCategorie" textFill="red" GridPane.rowIndex="13" GridPane.columnIndex="1" />

                <!-- Image -->
                <Label text="Image" GridPane.rowIndex="14" GridPane.columnIndex="0" />
                <HBox spacing="5" GridPane.rowIndex="14" GridPane.columnIndex="1">
                    <TextField fx:id="txtImage" editable="false" promptText="Aucune image sélectionnée" HBox.hgrow="ALWAYS"/>
                    <Button text="📁" onAction="#choisirImage"
                            style="-fx-background-color: linear-gradient(to right, #9b59b6, #8e44ad);
                                   -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-background-radius: 25; -fx-cursor: hand;" />
                </HBox>

                <!-- Prix -->
                <Label text="Prix (DT)" GridPane.rowIndex="15" GridPane.columnIndex="0" />
                <TextField fx:id="txtPrix" promptText="Ex: 50.0" GridPane.rowIndex="15" GridPane.columnIndex="1" />
                <Label fx:id="lblErreurPrix" textFill="red" GridPane.rowIndex="16" GridPane.columnIndex="1" />
            </GridPane>

            <!-- Boutons -->
            <HBox spacing="15" alignment="CENTER">
                <Button text="➕ Ajouter"
                        onAction="#ajouterEvenement"
                        style="-fx-font-weight: bold;
                               -fx-background-color: linear-gradient(to right, #74ebd5, #acb6e5);
                               -fx-text-fill: #2c3e50; -fx-background-radius: 25;
                               -fx-padding: 8 20; -fx-cursor: hand;" />

                <Button fx:id="btnReset" text="🧹 Vider" onAction="#viderFormulaire"
                        style="-fx-background-color: linear-gradient(to right, #fbc2eb, #a6c1ee);
                               -fx-text-fill: #2c3e50; -fx-font-weight: bold;
                               -fx-background-radius: 25; -fx-padding: 8 18; -fx-cursor: hand;" />
            </HBox>
        </VBox>
    </center>

    <!-- Footer -->
    <bottom>
        <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 10px;" alignment="CENTER">
            <Label text="© 2023 Système de Gestion Admin - Tous droits réservés"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>

</BorderPane>
