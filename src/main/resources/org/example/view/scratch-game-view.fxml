<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<?import java.lang.String?>
<StackPane fx:id="mainGamePane"
           xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.ScratchGameController"
           style="-fx-background-color: linear-gradient(to bottom, #fef9ff, #e8eaf6);">

    <children>
        <VBox alignment="CENTER"
              spacing="30"
              style="-fx-padding: 40;">

            <!-- 🎯 Titre -->
            <Label text="🎯 Carte à Gratter"
                   style="-fx-font-size: 26px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #8e44ad;" />

            <!-- 🃏 Cartes -->
            <HBox alignment="CENTER" spacing="20">
                <StackPane fx:id="card1" styleClass="scratch-card"/>
                <StackPane fx:id="card2" styleClass="scratch-card"/>
                <StackPane fx:id="card3" styleClass="scratch-card"/>
            </HBox>

            <!-- ✅ Résultat -->
            <Label fx:id="resultLabel"
                   style="-fx-font-size: 18px;
                          -fx-text-fill: #6c5ce7;
                          -fx-font-weight: bold;" />

            <!-- 🔁 Rejouer -->
            <Button text="🔁 Rejouer"
                    onAction="#rejouer"
                    style="-fx-background-color: #B388EB;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-font-weight: bold;
                           -fx-background-radius: 20;
                           -fx-padding: 10 30;" />
            <!-- 🔙 Bouton retour bas -->
            <Button text="⟵ Retour"
                    onAction="#retour"
                    style="-fx-background-color: #D9B3FF;
               -fx-text-fill: white;
               -fx-font-size: 14px;
               -fx-font-weight: bold;
               -fx-background-radius: 15px;
               -fx-padding: 6 18;" />
        </VBox>
    </children>

    <!-- ✅ STYLES externes -->
    <stylesheets>
        <String fx:value="/styles/scratch-game.css"/>
    </stylesheets>

</StackPane>
