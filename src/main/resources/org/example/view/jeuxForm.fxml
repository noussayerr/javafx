<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.JeuxController"
            prefHeight="300" prefWidth="600">
    <!-- Top Bar - Header (same as dashboard) -->
    <top>
        <HBox style="-fx-background-color: #34495e; -fx-padding: 15px;" alignment="CENTER_LEFT">
            <ImageView fitHeight="40" fitWidth="40">
                <Image url="@/images/admin-icon.png"/>
            </ImageView>
            <Label text="Gestion des Jeux"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 0 10;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="logoutButton"
                        text="Déconnexion"
                        onAction="#handleLogout"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Circle radius="20" fill="#3498db" stroke="#ecf0f1" strokeWidth="1"/>
            </HBox>
        </HBox>
    </top>

    <!-- Left Side - Navigation Menu (same as dashboard) -->
    <left>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 20px 10px;"
              spacing="15" prefWidth="200">
            <Label text="NAVIGATION" style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-padding: 0 0 10 5;"/>

            <Button text="Utilisateurs"
                    onAction="#goToUtilisateurs"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/users-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button  text="Matières"
                     style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;"
                     onAction="#goToMatiere">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/matiere-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Abonnements"
                    onAction="#handleAbonnementsNavigation"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/stats-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Événements"
                    fx:id="btnEvenements"
                    onAction="#afficherEvenements"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/events-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Jeux"
                    onAction="#afficherJeux"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/events-icon.png" />
                    </ImageView>
                </graphic>
            </Button>


            <Button text="Statistiques"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/stats-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button text="Paramètres"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/settings-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Aide"
                    style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 12px; -fx-alignment: CENTER_LEFT;">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="@/images/help-icon.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </VBox>
    </left>
    <center>
    <VBox style="-fx-padding: 20px;" spacing="20">
        <GridPane hgap="10" vgap="10">
            <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="nomField" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <Label fx:id="nomError" textFill="red"/>
            <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextArea fx:id="descriptionField" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <Label fx:id="descError" textFill="red"/>
            <Label text="Type:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="typeField" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <Label fx:id="typeError" textFill="red"/>
            <Label text="Date de Création:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <DatePicker fx:id="docPicker" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <Label fx:id="docError" textFill="red"/>
            <Label text="Game File:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="4">
                <TextField fx:id="filePathField" editable="false" promptText="No file selected"/>
                <Button text="Browse" onAction="#handleBrowse"/>
            </HBox>
            <Label fx:id="fileError" textFill="red"/>
            <Label text="controller File:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="5">
                <TextField fx:id="controllerPathField" editable="false" promptText="No file selected"/>
                <Button text="Browserrrr" onAction="#handleBrowseController"/>
            </HBox>
            <Label fx:id="controllerError" textFill="red"/>
        </GridPane>

        <HBox spacing="10">
            <Button text="Ajouter" onAction="#ajouterJeux"/>
            <Button text="Modifier" onAction="#modifierJeux"/>
            <Button text="Annuler" onAction="#goToList"/>
        </HBox>
    </VBox>
    </center>
</BorderPane>
