<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.controller.ModifierCategorieController"
            prefWidth="500" prefHeight="520"
            style="-fx-background-color: linear-gradient(to bottom right, #f4f3fe, #eaeafc);">

    <!-- 🌙 Bouton Thème -->
    <Button fx:id="btnTheme" layoutX="450" layoutY="15" text="🌙"
            onAction="#toggleTheme"
            style="-fx-background-color: #a29bfe;
                   -fx-text-fill: white;
                   -fx-background-radius: 50%;
                   -fx-cursor: hand;" />

    <VBox layoutX="30" layoutY="30" spacing="20" prefWidth="440">
        <!-- Titre -->
        <Label text="📝 Modifier une catégorie"
               style="-fx-font-size: 24px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #8e44ad;
                      -fx-underline: true;" />

        <!-- Formulaire -->
        <GridPane hgap="10" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="100"/>
                <ColumnConstraints minWidth="250"/>
            </columnConstraints>

            <!-- Nom -->
            <Label text="Nom :" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="txtNom" promptText="Nom de la catégorie" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label fx:id="lblErreurNom" text="" textFill="red" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <!-- Description -->
            <Label text="Description :" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextArea fx:id="txtDescription" promptText="Description"
                      prefRowCount="3"
                      GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label fx:id="lblErreurDescription" text="" textFill="red" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

            <!-- Image -->
            <Label text="Image :" style="-fx-text-fill: #2c3e50;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <HBox spacing="5" GridPane.rowIndex="4" GridPane.columnIndex="1">
                <TextField fx:id="txtImage" editable="false" promptText="Aucune image sélectionnée" HBox.hgrow="ALWAYS"/>
                <Button text="📁" onAction="#choisirImage"
                        style="-fx-background-color: linear-gradient(to right, #8e44ad, #9b59b6);
                               -fx-text-fill: white;
                               -fx-background-radius: 25;
                               -fx-cursor: hand;" />
            </HBox>
        </GridPane>

        <!-- Bouton Enregistrer -->
        <HBox alignment="CENTER" spacing="20">
            <Button text="💾 Enregistrer" onAction="#enregistrerModification"
                    style="-fx-background-color: linear-gradient(to right, #74ebd5, #acb6e5);
                           -fx-text-fill: #2c3e50;
                           -fx-font-weight: bold;
                           -fx-background-radius: 25;
                           -fx-padding: 8 20;
                           -fx-cursor: hand;" />
        </HBox>
    </VBox>
</AnchorPane>
