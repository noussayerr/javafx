<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>

<?import javafx.scene.effect.DropShadow?>
<AnchorPane xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.AbonnementApprenant"
            prefHeight="726.0" prefWidth="1310.0"
            style="-fx-background-color: #f5f7fa;">

    <!-- Header avec effet de verre -->
    <HBox style="-fx-background-color: rgba(255,255,255,0.3); -fx-background-radius: 15;" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
        <effect>
            <DropShadow blurType="GAUSSIAN" color="rgba(0,0,0,0.1)" height="10" radius="10" width="10" />
        </effect>

        <ImageView fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@/images/admin-icon.png" />
            </image>
        </ImageView>

        <Label style="-fx-text-fill: #3a4a6d; -fx-font-size: 24px; -fx-font-weight: bold;" text="DysCover" HBox.hgrow="ALWAYS" />

        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 0 15 0 0;">
            <Button onAction="#goAccueil" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Accueil" />
            <Button onAction="#goMatiereF" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Cours" />
            <Button fx:id="profileButton" onAction="#ouvrirListeEvenements" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="les Événements" />
            <Button onAction="#showGames" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Jeux" />
            <Button fx:id="btnAbonnement" onAction="#goAbonnement" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Abonnement" />
            <Button fx:id="btnReclamation" onAction="#goReclamation" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Reclamations" />
            <Button fx:id="btnEvenements" onAction="#handleProfile" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Profil" />
            <Button fx:id="logoutButton" onAction="#logout" style="-fx-background-color: transparent; -fx-text-fill: #3a4a6d; -fx-font-weight: bold;" text="Déconnexion">

                <HBox.margin>
                    <Insets left="300.0" />
                </HBox.margin></Button>
        </HBox>
    </HBox>


    <!-- Main Content - Subscription Section -->
    <VBox alignment="TOP_CENTER" spacing="20.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="100.0">
        <!-- Header -->
        <HBox style="-fx-background-color: white; -fx-padding: 15 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 5, 0, 0, 2);">
            <Label text="Mes Abonnements" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;">
                <HBox.margin>
                    <Insets left="20"/>
                </HBox.margin>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button style="-fx-background-color: transparent;">
                <graphic>
                    <ImageView fitWidth="30" fitHeight="30">
                        <Image url="@/icons/notification.jpg"/>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>

        <!-- Subscription Cards -->
        <ScrollPane fitToWidth="true" style="-fx-background: #f5f7fa; -fx-border-color: transparent;">
            <VBox style="-fx-padding: 20;">
                <Label text="Abonnements Disponibles" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <!-- Horizontal Scrollable Subscription Cards -->
                <ScrollPane fitToHeight="true" style="-fx-background-color: transparent; -fx-padding: 10;">
                    <HBox fx:id="abonnementsContainer" spacing="15" style="-fx-padding: 10;">
                        <!-- Subscription cards will be added dynamically by controller -->
                    </HBox>
                </ScrollPane>
            </VBox>

        </ScrollPane>
        <HBox alignment="CENTER" style="-fx-padding: 20;">
            <Button text="Voir mes transactions" onAction="#handleGoToTransactions" style="-fx-font-size: 14px; -fx-background-color: #3498db; -fx-text-fill: white; -fx-padding: 10 20; -fx-background-radius: 5;"/>
        </HBox>
    </VBox>
</AnchorPane>