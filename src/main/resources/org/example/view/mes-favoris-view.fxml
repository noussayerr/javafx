<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<StackPane fx:id="mainContainer"
           xmlns="http://javafx.com/javafx/23.0.1"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.MesFavorisController"
           prefWidth="400" prefHeight="750"
           style="-fx-background-color: linear-gradient(to bottom, #fef9ff, #e8eaf6);">

    <children>
        <BorderPane style="-fx-padding: 20;">

            <!-- 🌟 Titre en haut -->
            <top>
                <Label text="💖 Mes Favoris"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #8e44ad;"
                       BorderPane.alignment="CENTER" />
            </top>

            <!-- 📜 Contenu Scrollable -->
            <center>
                <ScrollPane fx:id="scrollPane"
                            fitToWidth="true"
                            style="-fx-background-color: transparent;"
                            prefHeight="600">
                    <content>
                        <VBox fx:id="favorisContainer"
                              spacing="20"
                              alignment="TOP_CENTER"
                              style="-fx-padding: 20;" />
                    </content>
                </ScrollPane>
            </center>

            <!-- 🔙 Bouton Retour bien positionné -->
            <bottom>
                <VBox alignment="CENTER">
                    <Button text="⟵ Retour"
                            onAction="#retour"
                            style="-fx-background-color: #D9B3FF;
                                   -fx-text-fill: white;
                                   -fx-font-size: 14px;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 20px;
                                   -fx-padding: 8 20;" />
                </VBox>
            </bottom>

        </BorderPane>
    </children>

    <!-- 🎨 Feuilles de style externes -->
    <stylesheets>
        <String fx:value="/styles/scrollPane.css" />
        <String fx:value="/styles/animations.css" />
        <String fx:value="/styles/advanced.css" />
        <String fx:value="/styles/modern-events.css" />
    </stylesheets>

</StackPane>
