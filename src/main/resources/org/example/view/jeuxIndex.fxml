<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns="http://javafx.com/javafx/16"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.JeuxController"
            style="-fx-background-color: #f5f7fa;">

    <!-- Top Bar - Header (same as dashboard) -->
    <top>
        <HBox style="-fx-background-color: #34495e; -fx-padding: 15px;" alignment="CENTER_LEFT">
            <ImageView fitHeight="40" fitWidth="40">
                <Image url="@/images/admin-icon.png"/>
            </ImageView>
            <Label text="Gestion des Jeux"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 0 10;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="logoutButton"
                        text="Déconnexion"
                        onAction="#handleLogout"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;"/>
                <Circle radius="20" fill="#3498db" stroke="#ecf0f1" strokeWidth="1"/>
            </HBox>
        </HBox>
    </top>

    <!-- Left Side - Navigation Menu (same as dashboard) -->
    <left>
        <VBox prefWidth="200" spacing="15" style="-fx-background-color: #2c3e50; -fx-padding: 20px 10px;">
            <Label style="-fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-padding: 0 0 10 5;" text="NAVIGATION" />

            <Button onAction="#goToUtilisateurs" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;" text="Utilisateurs">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/users-icon.png" />
                    </ImageView>
                </graphic>
            </Button>

            <Button onAction="#goToMatiere" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;" text="Matières">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/matiere-icon.png" />
                    </ImageView>
                </graphic>
            </Button>

            <Button onAction="#handleAbonnementsNavigation" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;" text="Abonnements">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/stats-icon.png" />
                    </ImageView>
                </graphic>
            </Button>

            <Button fx:id="btnEvenements" onAction="#afficherEvenements" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;" text="Événements">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/events-icon.png" />
                    </ImageView>
                </graphic>
            </Button>

            <Button onAction="#afficherJeux" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;" text="Jeux">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/events-icon.png" />
                    </ImageView>
                </graphic>
            </Button>

            <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;" text="Statistiques">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/stats-icon.png" />
                    </ImageView>
                </graphic>
            </Button>

            <Button style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER_LEFT;" text="Paramètres">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@/images/settings-icon.png" />
                    </ImageView>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS" />

            <Button style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 12px; -fx-alignment: CENTER_LEFT;" text="Aide">
                <graphic>
                    <ImageView fitHeight="16" fitWidth="16">
                        <Image url="@/images/help-icon.png" />
                    </ImageView>
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- Center - Game-specific content -->
    <center>
        <VBox style="-fx-padding: 20px;" spacing="20">
            <!-- Your original game content -->
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Button text="Ajouter un jeu" onAction="#goToAjout"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="deleteButton" text="Supprimer" onAction="#supprimerJeux" disable="true"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                    <Button fx:id="modifyButton" text="Modifier" onAction="#goToModifierForm" disable="true"
                            style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                    <Button fx:id="launchButton" text="Lancer le jeu" onAction="#launchGame" disable="true"
                            style="-fx-background-color: #9b59b6; -fx-text-fill: white;"/>
                    <Button fx:id="scoreButton" text="LeaderBoard" onAction="#goToLeaderboard"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                </HBox>
            </HBox>

            <TableView fx:id="jeuxTable" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="nomColumn" text="Nom" prefWidth="150"/>
                    <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="250"/>
                    <TableColumn fx:id="typeColumn" text="Type" prefWidth="100"/>
                    <TableColumn fx:id="docColumn" text="Date de Création" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- Bottom - Footer (same as dashboard) -->
    <bottom>
        <HBox style="-fx-background-color: #ecf0f1; -fx-padding: 10px;" alignment="CENTER">
            <Label text="© 2023 Système de Gestion Admin - Tous droits réservés"
                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;"/>
        </HBox>
    </bottom>
</BorderPane>