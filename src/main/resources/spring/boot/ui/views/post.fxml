<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="spring.boot.ui.controller.PostUIController"
            style="-fx-font-family: 'Segoe UI'; -fx-font-size: 12px;">

    <!-- Top: Title -->
    <top>
        <VBox style="-fx-background-color: #2c3e50; -fx-padding: 15;">
            <Label text="Gestion des Posts"
                   style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <!-- Center: Main content -->
    <center>
        <SplitPane dividerPositions="0.5" style="-fx-padding: 10;">
            <!-- Left: Form -->
            <VBox spacing="10" style="-fx-padding: 10; -fx-border-color: #ecf0f1; -fx-border-radius: 5;">
                <Label text="Ajouter/Modifier un Post" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>

                <VBox spacing="5">
                    <Label text="Titre:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="titleField" promptText="Entrez le titre du post"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Contenu:" style="-fx-font-weight: bold;"/>
                    <TextArea fx:id="contentArea" promptText="Entrez le contenu du post"
                              wrapText="true" style="-fx-control-inner-background: #f8f9fa;"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Auteur:" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="authorField" promptText="Entrez le nom de l'auteur"/>
                </VBox>

                <HBox spacing="10" style="-fx-padding: 10, 0, 0, 0;">
                    <Button fx:id="addButton" text="Ajouter" style="-fx-padding: 10; -fx-font-weight: bold;
                           -fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 12px;"
                           HBox.hgrow="ALWAYS"/>
                    <Button fx:id="updateButton" text="Modifier" style="-fx-padding: 10; -fx-font-weight: bold;
                           -fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 12px;"
                           HBox.hgrow="ALWAYS"/>
                    <Button fx:id="deleteButton" text="Supprimer" style="-fx-padding: 10; -fx-font-weight: bold;
                           -fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 12px;"
                           HBox.hgrow="ALWAYS"/>
                    <Button fx:id="clearButton" text="Effacer" style="-fx-padding: 10; -fx-font-weight: bold;
                           -fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 12px;"
                           HBox.hgrow="ALWAYS"/>
                </HBox>
            </VBox>

            <!-- Right: Table and Search -->
            <VBox spacing="10" style="-fx-padding: 10; -fx-border-color: #ecf0f1; -fx-border-radius: 5;">
                <HBox spacing="10">
                    <TextField fx:id="searchField" promptText="Rechercher par titre..." HBox.hgrow="ALWAYS"/>
                    <Button text="Rechercher" style="-fx-padding: 10; -fx-font-weight: bold;
                           -fx-background-color: #3498db; -fx-text-fill: white;" onAction="#handleSearch"/>
                </HBox>

                <TableView fx:id="postTable" style="-fx-border-color: #ecf0f1; -fx-border-radius: 5;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="titleColumn" text="Titre" prefWidth="200"/>
                        <TableColumn fx:id="authorColumn" text="Auteur" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </SplitPane>
    </center>

    <!-- Bottom: Status bar -->
    <bottom>
        <VBox style="-fx-background-color: #ecf0f1; -fx-padding: 10;">
            <Label text="Prêt" style="-fx-text-fill: #2c3e50;"/>
        </VBox>
    </bottom>
</BorderPane>

