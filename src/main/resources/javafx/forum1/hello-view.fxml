<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="javafx.forum1.controller.PosteController"
            styleClass="app-root">
    <top>
        <VBox spacing="6.0" styleClass="header-box">
            <padding>
                <Insets top="18.0" right="18.0" bottom="12.0" left="18.0"/>
            </padding>
            <Label styleClass="app-title" text="Forum1 - Gestion des postes"/>
            <Label styleClass="app-subtitle" text="Interface dynamique: selectionnez un poste pour voir et gerer ses commentaires"/>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.52" orientation="VERTICAL" styleClass="content-split">
            <items>
                <VBox spacing="10.0" styleClass="card">
                    <padding>
                        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                    </padding>

                    <Label styleClass="section-title" text="Postes"/>

                    <Label styleClass="field-label" text="Titre"/>
                    <TextField fx:id="titreField" promptText="Saisir un titre" styleClass="field"/>

                    <Label styleClass="field-label" text="Description"/>
                    <TextArea fx:id="descriptionArea" prefRowCount="3" promptText="Saisir une description" styleClass="field" wrapText="true"/>

                    <HBox spacing="8.0">
                        <Button fx:id="ajouterButton" onAction="#onAjouterClick" styleClass="btn btn-primary" text="Ajouter"/>
                        <Button fx:id="modifierButton" onAction="#onModifierClick" styleClass="btn btn-secondary" text="Modifier"/>
                        <Button fx:id="supprimerButton" onAction="#onSupprimerClick" styleClass="btn btn-danger" text="Supprimer"/>
                        <Button onAction="#onNouveauClick" styleClass="btn btn-ghost" text="Nouveau"/>
                    </HBox>

                    <TableView fx:id="posteTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="idColumn" prefWidth="70.0" text="ID"/>
                            <TableColumn fx:id="titreColumn" prefWidth="210.0" text="Titre"/>
                            <TableColumn fx:id="descriptionColumn" prefWidth="410.0" text="Description"/>
                            <TableColumn fx:id="dateCreationColumn" prefWidth="170.0" text="Date creation"/>
                        </columns>
                    </TableView>
                </VBox>

                <VBox spacing="10.0" styleClass="card">
                    <padding>
                        <Insets top="14.0" right="14.0" bottom="14.0" left="14.0"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label styleClass="section-title" text="Commentaires du poste selectionne"/>
                        <ToggleButton fx:id="triCommentairesToggle" onAction="#onToggleTriCommentairesClick" styleClass="btn btn-ghost" text="Tri: plus recents"/>
                    </HBox>

                    <TextArea fx:id="commentaireArea" prefRowCount="3" promptText="Saisir un commentaire" styleClass="field" wrapText="true"/>

                    <HBox spacing="8.0">
                        <Button fx:id="ajouterCommentaireButton" onAction="#onAjouterCommentaireClick" styleClass="btn btn-primary" text="Ajouter commentaire"/>
                        <Button fx:id="modifierCommentaireButton" onAction="#onModifierCommentaireClick" styleClass="btn btn-secondary" text="Modifier commentaire"/>
                        <Button fx:id="supprimerCommentaireButton" onAction="#onSupprimerCommentaireClick" styleClass="btn btn-danger" text="Supprimer commentaire"/>
                        <Button onAction="#onNouveauCommentaireClick" styleClass="btn btn-ghost" text="Nouveau commentaire"/>
                    </HBox>

                    <TableView fx:id="commentaireTable" styleClass="data-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="commentaireIdColumn" prefWidth="85.0" text="ID"/>
                            <TableColumn fx:id="commentaireContenuColumn" prefWidth="570.0" text="Contenu"/>
                            <TableColumn fx:id="commentaireDateColumn" prefWidth="190.0" text="Date creation"/>
                        </columns>
                    </TableView>
                </VBox>
            </items>
        </SplitPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar">
            <padding>
                <Insets top="10.0" right="18.0" bottom="12.0" left="18.0"/>
            </padding>
            <Label fx:id="messageLabel" styleClass="status-label" text="Pret"/>
        </HBox>
    </bottom>
</BorderPane>
