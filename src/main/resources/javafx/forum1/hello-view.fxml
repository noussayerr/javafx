<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="javafx.forum1.controller.PosteController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestion des postes"/>

    <Label text="Titre"/>
    <TextField fx:id="titreField" promptText="Saisir un titre"/>

    <Label text="Description"/>
    <TextArea fx:id="descriptionArea" prefRowCount="4" promptText="Saisir une description" wrapText="true"/>

    <HBox spacing="8.0">
        <Button onAction="#onAjouterClick" text="Ajouter"/>
        <Button fx:id="modifierButton" onAction="#onModifierClick" text="Modifier"/>
        <Button fx:id="supprimerButton" onAction="#onSupprimerClick" text="Supprimer"/>
        <Button onAction="#onNouveauClick" text="Nouveau"/>
    </HBox>

    <TableView fx:id="posteTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" prefWidth="70.0" text="ID"/>
            <TableColumn fx:id="titreColumn" prefWidth="180.0" text="Titre"/>
            <TableColumn fx:id="descriptionColumn" prefWidth="320.0" text="Description"/>
            <TableColumn fx:id="dateCreationColumn" prefWidth="160.0" text="Date creation"/>
        </columns>
    </TableView>

    <Label fx:id="messageLabel" style="-fx-text-fill: #1f4b99;" text="Pret"/>
</VBox>
